---
import * as icons from "@hugeicons/core-free-icons";
import { TAGS } from "../data/browsers";

// Icons used directly by the UI (tag icons are added automatically).
const UI_ICONS = ["Globe02Icon", "Search01Icon", "Tick02Icon", "SkullIcon", "Cancel01Icon", "Clock01Icon", "GithubIcon", "ArrowUpRight01Icon", "RedditIcon", "NewTwitterIcon", "RankingIcon"];
const names = [...new Set([...UI_ICONS, ...Object.values(TAGS).map((t) => t.icon)])];

const lib = icons as unknown as Record<string, [string, Record<string, string>][]>;
const kebab = (k: string) => k.replace(/[A-Z]/g, (c) => "-" + c.toLowerCase());
const symbols = names.map((name) => {
  const def = lib[name];
  if (!def) throw new Error(`Unknown Hugeicon: ${name}`);
  const body = def
    .map(([tag, attrs]) => `<${tag} ${Object.entries(attrs).filter(([k]) => k !== "key").map(([k, v]) => `${kebab(k)}="${v}"`).join(" ")}/>`)
    .join("");
  return `<symbol id="i-${name}" viewBox="0 0 24 24" fill="none">${body}</symbol>`;
}).join("");
---
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true" set:html={symbols} />
