---
// Hugeicons (free set) via an SVG sprite: <IconSprite/> (in the layout) defines every icon once,
// each <Icon/> is a tiny <use>. No client JS. Add new icon names to UI_ICONS in IconSprite.astro.
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 18, class: cls, label } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  class={cls}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
><use href={`#i-${name}`} /></svg>
