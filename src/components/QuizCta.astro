---
import Icon from "./Icon.astro";
import { localizedHref, type Locale } from "../i18n";

const CTA_COPY: Record<Locale, { title: string; text: string; label: string }> = {
  en: {
    title: "Not sure which one fits you?",
    text: "Answer five quick questions – OS, extensions, what matters to you, must-haves and dealbreakers – and get a ranked shortlist in about two minutes.",
    label: "Take the browser quiz",
  },
  ru: {
    title: "Не уверены, что подойдёт именно вам?",
    text: "Ответьте на пять быстрых вопросов — ОС, расширения, приоритеты, обязательные функции и стоп-факторы — и получите личный топ за пару минут.",
    label: "Пройти тест",
  },
  fr: {
    title: "Vous hésitez encore ?",
    text: "Répondez à cinq questions rapides – OS, extensions, priorités, indispensables et exclusions – et obtenez votre sélection en deux minutes.",
    label: "Faire le quiz",
  },
  pt: {
    title: "Ainda em dúvida?",
    text: "Responda a cinco perguntas rápidas – sistema, extensões, prioridades, itens obrigatórios e eliminatórios – e receba seu ranking em dois minutos.",
    label: "Fazer o quiz",
  },
  cs: {
    title: "Nevíte, který je pro vás?",
    text: "Odpovězte na pět rychlých otázek – OS, doplňky, priority, povinné funkce a stopky – a získejte žebříček asi za dvě minuty.",
    label: "Spustit kvíz",
  },
};

interface Props { lang?: Locale; href?: string; title?: string; text?: string; label?: string }
const { lang = "en", href, title, text, label } = Astro.props;
const def = CTA_COPY[lang];
---
<aside class="cta">
  <div>
    <p class="cta-t">{title ?? def.title}</p>
    <p class="cta-p">{text ?? def.text}</p>
  </div>
  <a class="cta-b" href={href ?? localizedHref("/quiz", lang)}>{label ?? def.label}<Icon name="ArrowRight01Icon" size={15} /></a>
</aside>
