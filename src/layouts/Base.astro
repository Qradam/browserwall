---
import "@fontsource-variable/inter";
import "@fontsource-variable/geist";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import IconSprite from "../components/IconSprite.astro";
import Consent from "../components/Consent.astro";
import BrowserDialog from "../components/BrowserDialog.astro";
import { SITE_NAME, abs, cleanPath, CATEGORIES, GUIDES, ALTERNATIVE_IDS, COMPARISONS, fillYear } from "../lib/seo";
import { byId } from "../data/browsers";
import { NEWS } from "../lib/news";
import { ogImageFor } from "../lib/og";

interface Props {
  title?: string;
  description?: string;
  /** JSON-LD objects for this page (WebSite/Organization are added on every page). */
  jsonLd?: object[];
  ogType?: "website" | "article";
  noindex?: boolean;
  /** Set false on pages that don't need the details dialog (saves the embedded data). */
  dialog?: boolean;
}
const {
  title = "browserwall – desktop browsers, a tier maker and a quiz",
  description = "A curated wall of 80+ desktop web browsers with honest scores, a tier list maker and a 2-minute quiz that finds the right browser for you.",
  jsonLd = [], ogType = "website", noindex = false, dialog = true,
} = Astro.props;
const path = cleanPath(Astro.url.pathname);
const canonical = abs(Astro.site, path);
const ogPath = ogImageFor(path);
const ogImage = abs(Astro.site, ogPath);
const site = abs(Astro.site, "/");
const graph = [
  { "@type": "WebSite", "@id": `${site}#website`, name: SITE_NAME, url: site, inLanguage: "en",
    description: "Curated directory of desktop web browsers with editorial scores, a tier list maker and a browser recommendation quiz.",
    potentialAction: { "@type": "SearchAction", target: `${site}wall?q={search_term_string}`, "query-input": "required name=search_term_string" } },
  { "@type": "Organization", "@id": `${site}#org`, name: SITE_NAME, url: site, logo: abs(Astro.site, "/icon-512.png") },
  ...(noindex ? [] : [{ "@type": "WebPage", "@id": `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: "en", isPartOf: { "@id": `${site}#website` },
    primaryImageOfPage: { "@type": "ImageObject", url: ogImage, contentUrl: ogImage, width: 1200, height: 630, caption: ogPath === "/og.png" ? "browserwall – find your browser" : title,
      creator: { "@id": `${site}#org` }, creditText: SITE_NAME, copyrightNotice: `© ${new Date().getFullYear()} ${SITE_NAME}`,
      license: "https://creativecommons.org/licenses/by/4.0/", acquireLicensePage: abs(Astro.site, "/image-license") } }]),
  ...jsonLd,
];
const ld = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
const popularAlt = ALTERNATIVE_IDS.slice(0, 6).map((id) => byId.get(id)!);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <><link rel="canonical" href={canonical} /><meta name="robots" content="max-image-preview:large, max-snippet:-1" /></>}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
    {!noindex && <link rel="alternate" type="text/markdown" title="This page as Markdown" href={`${path === "/" ? "/index" : path}.md`} />}
    <link rel="alternate" type="application/rss+xml" title="browserwall news" href="/news/rss.xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogPath === "/og.png" ? "browserwall – find your browser" : title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body>
    <IconSprite />
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <a href="/" class="brand" aria-label="browserwall home"><Logo size={26} /> <span>browserwall</span></a>
      <nav aria-label="Main">
        <a href="/wall" aria-current={path.startsWith("/wall") ? "page" : undefined}>Wall</a>
        <a href="/tiers" aria-current={path.startsWith("/tiers") ? "page" : undefined}>Tier maker</a>
        <a href="/compare" aria-current={path.startsWith("/compare") ? "page" : undefined}>Compare</a>
        <a href="/quiz" aria-current={path.startsWith("/quiz") ? "page" : undefined}>Quiz <span class="soon">beta</span></a>
        <a href="/news" aria-current={path.startsWith("/news") ? "page" : undefined}>News</a>
        <a href="/contact" class="nav-contact" aria-current={path.startsWith("/contact") ? "page" : undefined}>Contact</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    {dialog && <BrowserDialog />}
    <footer class="foot">
      <nav class="foot-links" aria-label="Guides">
        <div>
          <p class="fh">Find a browser</p>
          <a href="/quiz">Browser quiz</a>
          <a href="/best">All guides</a>
          {CATEGORIES.slice(0, 5).map((c) => <a href={`/best/${c.slug}`}>{c.short}</a>)}
        </div>
        <div>
          <p class="fh">More guides</p>
          {CATEGORIES.slice(5, 12).map((c) => <a href={`/best/${c.slug}`}>{c.short}</a>)}
          {GUIDES.map((g) => <a href={`/guides/${g.slug}`}>{fillYear(g.short)}</a>)}
        </div>
        <div>
          <p class="fh">Alternatives</p>
          <a href="/alternatives">All alternatives</a>
          {popularAlt.map((b) => <a href={`/alternatives/${b.id}`}>{b.name} alternatives</a>)}
        </div>
        <div>
          <p class="fh">browserwall</p>
          <a href="/wall">Browser wall</a>
          <a href="/compare">Compare browsers</a>
          {COMPARISONS.slice(0, 3).map((c) => <a href={`/compare/${c.slug}`}>{c.a.name} vs {c.b.name}</a>)}
          <a href="/tiers">Tier maker</a>
          <a href="/news">News</a>
          {NEWS.slice(0, 2).map((n) => <a href={`/news/${n.slug}`}>{n.short}</a>)}
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/image-license">Image licence</a>
          <a href="#" data-cookie-settings>Cookie settings</a>
        </div>
      </nav>
      <p class="fine">Logos are trademarks of their respective owners. Data curated by hand – spotted a mistake? <a href="/contact">Get in touch</a>.</p>
    </footer>
    <Consent />
  </body>
</html>
