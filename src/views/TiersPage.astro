---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { browsers, FAMILIES, type Family } from "../data/browsers";
import { faqLd } from "../lib/seo";
import { localizedHref, type Locale } from "../i18n";
import { UI } from "../i18n/ui";
import { TIERS_PAGE_COPY } from "../i18n/pages";

interface Props { lang?: Locale }
const { lang = "en" } = Astro.props;
const t = TIERS_PAGE_COPY[lang];
const ui = UI[lang];

const TIERS = [
  { id: "S", color: "#ff7f7f" }, { id: "A", color: "#ffbf7f" }, { id: "B", color: "#ffdf7f" },
  { id: "C", color: "#bfff7f" }, { id: "D", color: "#7fbfff" },
];
const famCount = new Map<Family, number>();
for (const b of browsers) famCount.set(b.family, (famCount.get(b.family) ?? 0) + 1);
const FAQ = t.faq(browsers.length);
const initials = (n: string) => n.replace(/[^A-Za-z0-9 ]/g, "").split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase();
const tiersI18n = JSON.stringify({
  lang,
  ...t.js,
  movedOne: t.js.movedMsg(1),
  movedMany: t.js.movedMsg(99).replace("99", "{n}"),
}).replace(/</g, "\\u003c");
---
<Base lang={lang} jsonLd={[faqLd(FAQ)]} title={t.metaTitle} description={t.metaDesc}>
  <section class="hero">
    <h1>{t.h1}</h1>
    <p>{t.heroSubBefore} <kbd>1</kbd>–<kbd>5</kbd> (<kbd>0</kbd> {t.heroSubAfter}</p>
  </section>

  <div class="titlebar">
    <label class="sr" for="list-title">{t.listTitleLabel}</label>
    <input id="list-title" class="list-title" value={t.defaultTitle} maxlength="60" spellcheck="false" />
    <div class="actions">
      <button type="button" class="btn" id="share"><Icon name="Link01Icon" size={14} />{t.copyLink}</button>
      <button type="button" class="btn" id="save-img"><Icon name="ArrowUpRight01Icon" size={14} />{t.saveImg}</button>
      <button type="button" class="btn ghost" id="clear"><Icon name="RefreshIcon" size={14} />{t.reset}</button>
    </div>
  </div>
  <p id="toast" class="toast" role="status" aria-live="polite"></p>

  <div class="board" id="board">
    {TIERS.map((tier, i) => (
      <section class="row" style={`--tier:${tier.color}`} data-tier={i}>
        <div class="label">
          <input aria-label={t.tierNameAria(i + 1)} value={tier.id} maxlength="12" spellcheck="false" />
        </div>
        <ul class="zone" data-zone={i} aria-label={t.tierAria(i + 1)}></ul>
      </section>
    ))}
  </div>

  <div class="selbar" id="selbar" hidden>
    <span id="sel-name"></span>
    <span class="dim">{t.tapPlace}</span>
    <button type="button" class="btn" id="sel-info"><Icon name="InformationCircleIcon" size={14} />{t.details}</button>
    <button type="button" class="btn" id="sel-pool">{t.backToPool}</button>
    <button type="button" class="btn ghost" id="sel-cancel" aria-label={t.cancelSel}><Icon name="Cancel01Icon" size={14} /></button>
  </div>

  <section class="pool-wrap" aria-label={t.poolAria}>
    <div class="filters">
      <div class="seg" role="group" aria-label={t.familyAria}>
        <button type="button" class="chip" data-fam="" aria-pressed="true">{t.allFam}</button>
        {(Object.keys(FAMILIES) as Family[]).filter((f) => famCount.has(f)).map((f) => (
          <button type="button" class="chip" data-fam={f} aria-pressed="false" title={ui.families[f].hint}>{ui.families[f].label}<span class="n">{famCount.get(f)}</span></button>
        ))}
      </div>
      <div class="seg" role="group" aria-label={t.includeAria}>
        <button type="button" class="chip" data-inc="channels" aria-pressed="false">{t.channels}</button>
        <button type="button" class="chip" data-inc="dead" aria-pressed="true">{t.discontinued}</button>
        <button type="button" class="chip" data-inc="meme" aria-pressed="true">{t.memes}</button>
      </div>
      <label class="search"><Icon name="Search01Icon" size={14} /><input id="pool-q" type="search" placeholder={t.findPlaceholder} aria-label={t.findAria} autocomplete="off" /></label>
      <span class="dim" id="pool-count"></span>
      <button type="button" class="btn ghost" id="fill" title={t.onlyFilteredTitle}>{t.onlyFiltered}</button>
    </div>
    <ul class="zone pool" id="pool" data-zone="pool">
      {browsers.map((b) => (
        <li class="item" tabindex="0" draggable="true" data-id={b.id} data-name={b.name.toLowerCase()} data-family={b.family}
          data-channel={b.channelOf ? "1" : "0"} data-dead={b.status === "discontinued" ? "1" : "0"} data-meme={b.tags.includes("meme") ? "1" : "0"}
          title={b.name} aria-label={b.name}>
          {b.logo ? <img src={b.logo} alt="" width="40" height="40" loading="lazy" decoding="async" draggable="false" /> : <span class="mono">{initials(b.name)}</span>}
          <span class="name">{b.name}</span>
        </li>
      ))}
    </ul>
    <p class="empty dim" id="pool-empty" hidden>{t.poolEmpty}</p>
  </section>

  <section class="about" aria-labelledby="about-t">
    <h2 id="about-t">{t.aboutHeading}</h2>
    <p>{t.aboutP1(browsers.length)}</p>
    <p>{t.aboutP2Before}<a href={localizedHref("/wall", lang)}>{t.aboutP2Wall}</a>{t.aboutP2Mid}<a href={localizedHref("/quiz", lang)}>{t.aboutP2Quiz}</a>{t.aboutP2After}</p>
    <h2>{t.faqHeading}</h2>
    <dl>{FAQ.map((f) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}</dl>
  </section>
  <script type="application/json" id="tiers-i18n" set:html={tiersI18n} />
</Base>

<script>
  import { openBrowser } from "../scripts/dialog";

  interface TiersI18n {
    defaultTitle: string;
    unplacedSuffix: string;
    movedOne: string;
    movedMany: string;
    alreadyFiltered: string;
    confirmClear: string;
    linkCopied: string;
    copyPrompt: string;
    madeOn: string;
    loadedShared: string;
  }
  const ti = JSON.parse(document.getElementById("tiers-i18n")!.textContent!) as TiersI18n;

  const KEY = "bw-tiers-v1";
  type State = { title: string; labels: string[]; rows: string[][]; scope: { fam: string[]; channels: boolean; dead: boolean; meme: boolean } };
  const zones = [...document.querySelectorAll<HTMLElement>("#board .zone")];
  const labelInputs = [...document.querySelectorAll<HTMLInputElement>("#board .label input")];
  const pool = document.querySelector<HTMLElement>("#pool")!;
  const items = [...pool.querySelectorAll<HTMLElement>(".item")]; // original (usage) order
  const byId = new Map(items.map((el) => [el.dataset.id!, el]));
  const titleInput = document.querySelector<HTMLInputElement>("#list-title")!;
  const q = document.querySelector<HTMLInputElement>("#pool-q")!;
  const toast = document.querySelector<HTMLElement>("#toast")!;
  const defaults = (): State => ({ title: ti.defaultTitle, labels: labelInputs.map((i) => i.defaultValue), rows: zones.map(() => []), scope: { fam: [], channels: false, dead: true, meme: true } });

  function decode(s: string): State | null {
    try {
      const v = JSON.parse(s);
      if (!Array.isArray(v.rows) || !Array.isArray(v.labels)) return null;
      const d = defaults();
      return { ...d, ...v, scope: { ...d.scope, ...(v.scope ?? {}) }, rows: d.rows.map((_, i) => (v.rows[i] ?? []).filter((id: string) => byId.has(id))) };
    } catch { return null; }
  }
  // Shared link (#t=...) wins over local save.
  const fromHash = location.hash.startsWith("#t=") ? decode(decodeURIComponent(location.hash.slice(3))) : null;
  let state: State = fromHash ?? decode(localStorage.getItem(KEY) ?? "") ?? defaults();

  function save() {
    localStorage.setItem(KEY, JSON.stringify(state));
    if (location.hash) history.replaceState(null, "", location.pathname);
  }
  let toastTimer = 0;
  const say = (msg: string) => { toast.textContent = msg; clearTimeout(toastTimer); toastTimer = window.setTimeout(() => (toast.textContent = ""), 2500); };

  // --- rendering ---------------------------------------------------------
  function inScope(el: HTMLElement) {
    const s = state.scope, d = el.dataset;
    const terms = q.value.trim().toLowerCase();
    return (!s.fam.length || s.fam.includes(d.family!)) && (s.channels || d.channel === "0") && (s.dead || d.dead === "0") &&
      (s.meme || d.meme === "0") && (!terms || d.name!.includes(terms));
  }
  function render() {
    const placed = new Set(state.rows.flat());
    state.rows.forEach((ids, i) => zones[i].append(...ids.map((id) => byId.get(id)!)));
    pool.append(...items.filter((el) => !placed.has(el.dataset.id!)));
    let shown = 0;
    for (const el of items) {
      const inPool = !placed.has(el.dataset.id!);
      el.hidden = inPool && !inScope(el);
      if (inPool && !el.hidden) shown++;
    }
    document.querySelector("#pool-count")!.textContent = `${shown} ${ti.unplacedSuffix}`;
    document.querySelector<HTMLElement>("#pool-empty")!.hidden = shown > 0;
    labelInputs.forEach((inp, i) => (inp.value = state.labels[i] ?? inp.defaultValue));
    titleInput.value = state.title;
    document.querySelectorAll<HTMLElement>("[data-fam]").forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.fam ? state.scope.fam.includes(b.dataset.fam) : !state.scope.fam.length)));
    document.querySelectorAll<HTMLElement>("[data-inc]").forEach((b) => b.setAttribute("aria-pressed", String(state.scope[b.dataset.inc as "channels" | "dead" | "meme"])));
  }

  /** Move a browser to tier `to` (index) or back to the pool (-1), optionally before another item. */
  function move(id: string, to: number, before?: string) {
    state.rows = state.rows.map((r) => r.filter((x) => x !== id));
    if (to >= 0) {
      const row = state.rows[to];
      const at = before ? row.indexOf(before) : -1;
      at >= 0 ? row.splice(at, 0, id) : row.push(id);
    }
    save(); render();
  }

  // --- selection (tap / click / keyboard) --------------------------------
  let selected: string | null = null;
  const selbar = document.querySelector<HTMLElement>("#selbar")!;
  function select(id: string | null) {
    selected = id;
    items.forEach((el) => el.classList.toggle("sel", el.dataset.id === id));
    selbar.hidden = !id;
    document.body.classList.toggle("placing", !!id);
    if (id) document.querySelector("#sel-name")!.textContent = byId.get(id)!.title;
  }
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const item = t.closest<HTMLElement>(".item");
    if (item) { select(selected === item.dataset.id ? null : item.dataset.id!); return; }
    const zone = t.closest<HTMLElement>("[data-zone]");
    if (zone && selected) { move(selected, zone.dataset.zone === "pool" ? -1 : +zone.dataset.zone!); select(null); }
  });
  document.querySelector("#sel-info")!.addEventListener("click", () => selected && openBrowser(selected));
  document.querySelector("#sel-pool")!.addEventListener("click", () => { if (selected) move(selected, -1); select(null); });
  document.querySelector("#sel-cancel")!.addEventListener("click", () => select(null));
  document.addEventListener("keydown", (e) => {
    const el = (e.target as HTMLElement).closest?.(".item") as HTMLElement | null;
    if (e.key === "Escape" && selected) return select(null);
    if (!el) return;
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(selected === el.dataset.id ? null : el.dataset.id!); }
    else if (/^[0-5]$/.test(e.key)) { e.preventDefault(); const id = el.dataset.id!; move(id, +e.key - 1); select(null); byId.get(id)!.focus(); }
    else if (e.key.toLowerCase() === "i") openBrowser(el.dataset.id!);
  });

  // --- drag & drop (mouse) -----------------------------------------------
  let dragId: string | null = null;
  items.forEach((el) => {
    el.addEventListener("dragstart", (e) => { dragId = el.dataset.id!; e.dataTransfer!.setData("text/plain", dragId); e.dataTransfer!.effectAllowed = "move"; el.classList.add("dragging"); });
    el.addEventListener("dragend", () => { el.classList.remove("dragging"); document.querySelectorAll(".over").forEach((z) => z.classList.remove("over")); dragId = null; });
  });
  // Item to insert before: first visible sibling whose centre is right of / below the pointer.
  const beforeAt = (zone: HTMLElement, x: number, y: number) =>
    [...zone.querySelectorAll<HTMLElement>(".item:not([hidden]):not(.dragging)")].find((c) => {
      const r = c.getBoundingClientRect();
      return y < r.top || (y <= r.bottom && x < r.left + r.width / 2);
    })?.dataset.id;
  document.querySelectorAll<HTMLElement>("[data-zone]").forEach((zone) => {
    zone.addEventListener("dragover", (e) => { if (!dragId) return; e.preventDefault(); zone.classList.add("over"); });
    zone.addEventListener("dragleave", (e) => { if (!zone.contains(e.relatedTarget as Node)) zone.classList.remove("over"); });
    zone.addEventListener("drop", (e) => {
      e.preventDefault(); zone.classList.remove("over");
      if (!dragId) return;
      const pooled = zone.dataset.zone === "pool";
      move(dragId, pooled ? -1 : +zone.dataset.zone!, pooled ? undefined : beforeAt(zone, e.clientX, e.clientY));
      select(null);
    });
  });

  // --- filters, labels, actions ------------------------------------------
  document.querySelectorAll<HTMLElement>("[data-fam]").forEach((b) => b.addEventListener("click", () => {
    const f = b.dataset.fam!, fam = state.scope.fam;
    state.scope.fam = !f ? [] : fam.includes(f) ? fam.filter((x) => x !== f) : [...fam, f];
    save(); render();
  }));
  document.querySelectorAll<HTMLElement>("[data-inc]").forEach((b) => b.addEventListener("click", () => {
    const k = b.dataset.inc as "channels" | "dead" | "meme";
    state.scope[k] = !state.scope[k]; save(); render();
  }));
  q.addEventListener("input", render);
  labelInputs.forEach((inp, i) => inp.addEventListener("input", () => { state.labels[i] = inp.value; save(); }));
  titleInput.addEventListener("input", () => { state.title = titleInput.value; save(); });
  // "Tiers: only filtered": send placed browsers outside the current filters back to the pool, e.g. to make a Chromium-only list.
  document.querySelector("#fill")!.addEventListener("click", () => {
    const keep = new Set(items.filter((el) => inScope(el)).map((el) => el.dataset.id!));
    const before = state.rows.flat().length;
    state.rows = state.rows.map((r) => r.filter((id) => keep.has(id)));
    const removed = before - state.rows.flat().length;
    save(); render();
    say(removed ? (removed === 1 ? ti.movedOne : ti.movedMany.replace("{n}", String(removed))) : ti.alreadyFiltered);
  });
  document.querySelector("#clear")!.addEventListener("click", () => {
    if (state.rows.flat().length && !confirm(ti.confirmClear)) return;
    state = defaults(); save(); render(); select(null);
  });
  document.querySelector("#share")!.addEventListener("click", async () => {
    const url = `${location.origin}${location.pathname}#t=${encodeURIComponent(JSON.stringify(state))}`;
    try { await navigator.clipboard.writeText(url); say(ti.linkCopied); }
    catch { prompt(ti.copyPrompt, url); }
  });

  // --- save as PNG (drawn on a canvas; logos are same-origin) -------------
  document.querySelector("#save-img")!.addEventListener("click", async () => {
    const rows = state.rows.map((ids, i) => ({ label: state.labels[i] || "", color: getComputedStyle(zones[i].parentElement!).getPropertyValue("--tier"), ids }));
    const S = 64, GAP = 6, PAD = 16, LABEL = 96, PER = 12, W = PAD * 2 + LABEL + PER * (S + GAP) + GAP;
    const heights = rows.map((r) => Math.max(1, Math.ceil(r.ids.length / PER)) * (S + GAP) + GAP);
    const H = PAD * 2 + 44 + heights.reduce((a, b) => a + b + 4, 0) + 20;
    const c = document.createElement("canvas");
    const dpr = 2; c.width = W * dpr; c.height = H * dpr;
    const g = c.getContext("2d")!; g.scale(dpr, dpr);
    g.fillStyle = "#161616"; g.fillRect(0, 0, W, H);
    g.fillStyle = "#dcddde"; g.font = "650 22px 'Inter Variable', sans-serif"; g.textBaseline = "middle";
    g.fillText(state.title || ti.defaultTitle, PAD, PAD + 16);
    const load = (src: string) => new Promise<HTMLImageElement | null>((res) => { const im = new Image(); im.onload = () => res(im); im.onerror = () => res(null); im.src = src; });
    let y = PAD + 44;
    for (const [i, r] of rows.entries()) {
      const h = heights[i];
      g.fillStyle = r.color.trim() || "#555"; g.fillRect(PAD, y, LABEL, h);
      g.fillStyle = "#1e1e1e"; g.fillRect(PAD + LABEL, y, W - PAD * 2 - LABEL, h);
      g.fillStyle = "#111"; g.font = "750 26px 'Inter Variable', sans-serif"; g.textAlign = "center";
      g.fillText(r.label.slice(0, 6), PAD + LABEL / 2, y + h / 2, LABEL - 8); g.textAlign = "left";
      for (const [j, id] of r.ids.entries()) {
        const el = byId.get(id)!, x = PAD + LABEL + GAP + (j % PER) * (S + GAP), yy = y + GAP + Math.floor(j / PER) * (S + GAP);
        g.fillStyle = "#262626"; g.fillRect(x, yy, S, S);
        const src = el.querySelector("img")?.getAttribute("src");
        const im = src ? await load(src) : null;
        if (im) g.drawImage(im, x + 8, yy + 4, S - 16, S - 16);
        g.fillStyle = "#8a8a8a"; g.font = "500 9px 'Inter Variable', sans-serif"; g.textAlign = "center";
        g.fillText(el.title.length > 13 ? el.title.slice(0, 12) + "…" : el.title, x + S / 2, im ? yy + S - 7 : yy + S / 2, S - 4); g.textAlign = "left";
      }
      y += h + 4;
    }
    g.fillStyle = "#5c5c5c"; g.font = "11px 'Inter Variable', sans-serif"; g.fillText(ti.madeOn, PAD, H - PAD);
    const a = document.createElement("a");
    a.download = `${(state.title || "tier-list").replace(/[^\w-]+/g, "-").toLowerCase()}.png`;
    a.href = c.toDataURL("image/png"); a.click();
  });

  render();
  if (fromHash) { save(); say(ti.loadedShared); }
</script>

<style>
  .about { max-width: 760px; margin: 40px 0 24px; color: var(--muted); font-size: 14.5px; line-height: 1.65; }
  .about h2 { margin: 28px 0 8px; font-size: 18px; font-weight: 640; color: var(--text); letter-spacing: -0.01em; }
  .about a { color: var(--accent); }
  .about dt { margin-top: 14px; color: var(--text); font-weight: 600; }
  .about dd { margin: 4px 0 0; }
  .hero { padding: 48px 0 20px; max-width: 760px; }
  h1 { font-size: clamp(28px, 4vw, 40px); letter-spacing: -0.03em; margin: 0 0 10px; font-weight: 680; }
  .hero p { color: var(--muted); margin: 0; font-size: 15px; }
  kbd { font: 11px var(--mono); color: var(--muted); border: 1px solid var(--line-2); border-radius: 4px; padding: 0 5px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .dim { color: var(--faint); font-size: 12.5px; }

  .titlebar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 10px; }
  .list-title { flex: 1; min-width: 200px; background: none; border: 1px solid transparent; border-radius: 6px; padding: 4px 8px; margin-left: -8px; font-size: 18px; font-weight: 620; }
  .list-title:hover, .list-title:focus { border-color: var(--line-2); outline: none; }
  .actions { display: flex; flex-wrap: wrap; gap: 6px; }
  .btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; border-radius: 7px; border: 1px solid var(--line); background: var(--bg-2); color: var(--text); font-size: 13px; cursor: pointer; }
  .btn:hover { border-color: var(--line-2); }
  .btn.ghost { background: none; color: var(--muted); }
  .toast { min-height: 18px; margin: 0 0 6px; color: var(--ok); font-size: 12.5px; }

  .board { display: flex; flex-direction: column; gap: 4px; margin-bottom: 18px; }
  .row { display: grid; grid-template-columns: 88px 1fr; min-height: 76px; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--bg-2); }
  .label { display: grid; place-items: center; background: var(--tier); }
  .label input { width: 100%; background: none; border: 0; text-align: center; font: 750 24px var(--font); color: #111; letter-spacing: -0.02em; }
  .label input:focus { outline: 2px solid rgb(0 0 0 / .4); outline-offset: -6px; border-radius: 6px; }
  .zone { list-style: none; margin: 0; padding: 6px; display: flex; flex-wrap: wrap; align-content: flex-start; gap: 6px; min-width: 0; transition: background .12s; }
  .zone.over, :global(body.placing) .zone:hover { background: var(--accent-bg); }
  :global(body.placing) .zone { cursor: copy; }

  .item { width: 76px; padding: 6px 4px 5px; border-radius: 8px; background: var(--bg-3); border: 1px solid transparent; display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: grab; user-select: none; touch-action: manipulation; }
  .item[hidden] { display: none; }
  .item:hover { border-color: var(--line-2); }
  .item:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .item.sel { border-color: var(--accent); background: var(--accent-bg); }
  .item.dragging { opacity: .4; }
  .item img, .mono { width: 40px; height: 40px; object-fit: contain; pointer-events: none; filter: drop-shadow(0 0 1px rgb(255 255 255 / .45)); }
  .item[data-dead="1"] img { filter: grayscale(1); }
  .mono { display: grid; place-items: center; border-radius: 9px; background: var(--bg); font: 600 13px var(--mono); color: var(--muted); filter: none; }
  .name { font-size: 10.5px; line-height: 1.2; text-align: center; color: var(--muted); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .selbar { position: sticky; top: 58px; z-index: 4; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 12px; margin-bottom: 12px; border-radius: 10px; background: var(--bg-3); border: 1px solid var(--accent); }
  .selbar[hidden] { display: none; }
  #sel-name { font-weight: 600; }

  .pool-wrap { border: 1px dashed var(--line-2); border-radius: 10px; padding: 10px; }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-bottom: 8px; }
  .seg { display: flex; flex-wrap: wrap; gap: 4px; }
  .chip { display: inline-flex; align-items: center; gap: 5px; height: 28px; padding: 0 10px; border-radius: 6px; background: var(--bg-2); border: 1px solid var(--line); color: var(--muted); font-size: 12.5px; cursor: pointer; }
  .chip:hover { color: var(--text); border-color: var(--line-2); }
