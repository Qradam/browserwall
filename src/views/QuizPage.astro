---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { OS_OPTIONS, EXT_OPTIONS, SLIDERS, FEATURES, AVOID } from "../lib/quiz";
import { OS_MARK } from "../lib/os-marks";
import ShareCard from "../components/ShareCard.astro";
import { byId, browsers } from "../data/browsers";
import { YEAR, abs, faqLd, CATEGORIES, fillYear } from "../lib/seo";
import { localizedHref, type Locale } from "../i18n";
import { QUIZ_I18N } from "../i18n/quiz";
import { QUIZ_PAGE_COPY } from "../i18n/pages";
import "../styles/content.css";

interface Props { lang?: Locale }
const { lang = "en" } = Astro.props;
const q = QUIZ_I18N[lang];
const t = QUIZ_PAGE_COPY[lang];

const quizFaq = t.faq(browsers.length);
const EXT_LOGO: Record<string, string | null | undefined> = { chrome: byId.get("google-chrome")?.logo, firefox: byId.get("firefox")?.logo };
const STEPS = [
  { label: t.steps[0], icon: "LaptopIcon" }, { label: t.steps[1], icon: "PuzzleIcon" }, { label: t.steps[2], icon: "SlidersHorizontalIcon" },
  { label: t.steps[3], icon: "SparklesIcon" }, { label: t.steps[4], icon: "Cancel01Icon" },
];
const groupLabel = (g: string) => g === "Tabs & layout" ? q.featureGroups.tabs : g === "Privacy & openness" ? q.featureGroups.privacy : q.featureGroups.ai;
const quizHref = localizedHref("/quiz", lang);
const quizI18n = JSON.stringify({
  lang,
  quizPath: quizHref,
  importance: q.importance,
  nextLabel: t.next,
  showMatchesLabel: t.showMatches,
  js: t.js,
}).replace(/</g, "\\u003c");
---
<Base lang={lang} title={t.metaTitle(YEAR)} description={t.metaDesc(browsers.length)}
  jsonLd={[
    { "@type": "WebApplication", name: t.ldName, url: abs(Astro.site, quizHref), inLanguage: lang, applicationCategory: "UtilitiesApplication", operatingSystem: "Any (runs in the browser)", isAccessibleForFree: true, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }, description: t.ldDesc },
    faqLd(quizFaq),
  ]}>
  <div class="layout" id="layout" data-mode="steps">
    <section class="hero">
      <p class="kicker">{t.kicker}</p>
      <h1>{t.h1}</h1>
      <p class="sub">{t.sub}</p>
    </section>

    <form id="quiz" class="quiz" novalidate aria-label={t.formAria}>
      <ol class="stepper" aria-label={t.stepsAria}>
        {STEPS.map((s, i) => (
          <li><button type="button" data-goto={i} disabled={i > 0}><span class="dot"><Icon name={s.icon} size={14} /></span><span class="sl">{s.label}</span></button></li>
        ))}
      </ol>
      <button type="button" class="tune-title" id="tune" aria-expanded="false" aria-controls="quiz">
        <span><Icon name="SlidersHorizontalIcon" size={15} />{t.tuneTitle} <span class="dim">{t.tuneSub}</span></span>
        <span class="chev" aria-hidden="true"><Icon name="ArrowRight01Icon" size={14} /></span>
      </button>

      <fieldset class="step" data-step="0">
        <legend>{t.q0}</legend>
        <div class="picks cols-4 tiles">
          {OS_OPTIONS.map((o, i) => (
            <label class="pick"><input type="radio" name="os" value={o.id} /><span class="ticon"><svg class="osmark" width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path d={OS_MARK[o.id].path!} fill="currentColor" /></svg></span><span class="tl">{q.osLabels[o.id]}</span><kbd class="key">{i + 1}</kbd></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="step" data-step="1" hidden>
        <legend>{t.q1}</legend>
        <p class="help">{t.q1Help}</p>
        <div class="picks cols-3 tiles">
          {EXT_OPTIONS.map((o, i) => (
            <label class="pick"><input type="radio" name="ext" value={o.id} />
              <span class="ticon">{EXT_LOGO[o.id] ? <img src={EXT_LOGO[o.id]!} alt="" width="34" height="34" /> : <Icon name="PuzzleIcon" size={30} />}</span>
              <span class="tl">{q.ext[o.id].label}<small>{q.ext[o.id].hint}</small></span><kbd class="key">{i + 1}</kbd></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="step" data-step="2" hidden>
        <legend>{t.q2}</legend>
        <p class="help">{t.q2Help}</p>
        <div class="sliders">
          {SLIDERS.map((s) => (
            <div class="slider" data-sl={s.id}>
              <div class="sl-top">
                <label for={`sl-${s.id}`}>{q.sliders[s.id].title}</label>
                <output for={`sl-${s.id}`} id={`out-${s.id}`}>{q.importance[2]}</output>
              </div>
              <p class="sl-help" id={`slh-${s.id}`}>{q.sliders[s.id].help}</p>
              <input type="range" id={`sl-${s.id}`} data-slider={s.id} min="0" max="4" step="1" value="2" aria-describedby={`slh-${s.id}`} aria-valuetext={q.importance[2]} />
              <div class="ticks" aria-hidden="true">{q.importance.map((imp) => <span>{imp}</span>)}</div>
            </div>
          ))}
        </div>
      </fieldset>

      <fieldset class="step" data-step="3" hidden>
        <legend>{t.q3}</legend>
        <div class="explain">
          <p class="ex-nice"><b>{t.niceExplainTitle}</b> {t.niceExplainBody}</p>
          <p class="ex-must"><b>{t.mustExplainTitle}</b> {t.mustExplainBody}</p>
        </div>
        <div class="frows">
          {FEATURES.map((f, i) => (<>
            {(i === 0 || FEATURES[i - 1].group !== f.group) && <p class="fgroup">{groupLabel(f.group)}</p>}
            <div class="frow" role="radiogroup" aria-labelledby={`fl-${f.id}`} data-frow={f.id}>
              <span class="flabel" id={`fl-${f.id}`}>{q.features[f.id]}</span>
              <div class="seg3">
                <label class="o0"><input type="radio" name={`f-${f.id}`} value="0" checked />{t.optDontCare}</label>
                <label class="o1"><input type="radio" name={`f-${f.id}`} value="1" />{t.optNice}</label>
                <label class="o2"><input type="radio" name={`f-${f.id}`} value="2" />{t.optMust}<span class="left" aria-hidden="true"></span></label>
              </div>
            </div>
          </>))}
        </div>
      </fieldset>

      <fieldset class="step" data-step="4" hidden>
        <legend>{t.q4}</legend>
        <p class="help">{t.q4Help}</p>
        <div class="chips">
          {AVOID.map((a) => (
            <label class="chk"><input type="checkbox" name="avoid" value={a.id} /><Icon name="Cancel01Icon" size={12} />{q.avoid[a.id]}</label>
          ))}
        </div>
      </fieldset>

      <div class="nav">
        <button type="button" class="btn ghost" id="back"><Icon name="ArrowLeft01Icon" size={14} />{t.back}</button>
        <div class="peek" aria-live="polite">
          <span class="faces" id="faces" aria-hidden="true"></span>
          <span class="live" id="live"></span>
        </div>
        <button type="button" class="btn primary" id="next">{t.next}<Icon name="ArrowRight01Icon" size={14} /></button>
      </div>
      <p class="hint" id="hint"></p>
      <button type="button" class="btn ghost restart" id="restart"><Icon name="RefreshIcon" size={14} />{t.restart}</button>
    </form>

    <section id="results" class="results" hidden aria-labelledby="res-title">
      <h2 id="res-title" tabindex="-1">{t.resultsTitle}</h2>
      <p class="excluded dim" id="excluded"></p>
      <button type="button" class="share-cta" id="share-open" aria-haspopup="dialog">
        <span class="sc-spark" aria-hidden="true">✦</span>
        <span><b>{t.shareOpenTitle}</b><small>{t.shareOpenSub}</small></span>
        <Icon name="ArrowRight01Icon" size={16} />
      </button>
      <ol id="top" class="top"></ol>
      <h3 class="more-title" id="more-title">{t.moreTitle}</h3>
      <ol id="more" class="more"></ol>
      <div id="none" class="none" hidden></div>
      <details class="how">
        <summary>{t.howTitle}</summary>
        <p>{t.howBody}</p>
      </details>
    </section>
  </div>

  <section class="doc quiz-about" aria-labelledby="about-quiz">
    <h2 id="about-quiz">{t.aboutTitle}</h2>
    <div class="faq">{quizFaq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    <h2>{t.readyListTitle}</h2>
    <ul class="linkgrid">{CATEGORIES.slice(0, 8).map((c, idx) => <li><a href={`/best/${c.slug}`}>{fillYear(t.categoryTitles[idx] ?? c.title)}</a></li>)}</ul>
  </section>
  <ShareCard lang={lang} />
  <script type="application/json" id="quiz-i18n" set:html={quizI18n} />
</Base>

<script>
  import { SLIDERS, FEATURES, rank, defaultState, encode, decode, type QuizState, type Result, type SliderId, type FeatureId, type AvoidId } from "../lib/quiz";
  import { openBrowser } from "../scripts/dialog";
  import { initShareCard } from "../scripts/share-card";
  import type { Browser } from "../data/browsers";
  import { formatCount, type Locale, type PluralForms } from "../i18n";

  interface QuizClientI18n {
    lang: Locale;
    quizPath: string;
    importance: string[];
    nextLabel: string;
    showMatchesLabel: string;
    js: {
      hints: string[];
      browsersWord: PluralForms;
      leftCount: string;
      leftAria: string;
      fitSuffix: string;
      mustHaveTitle: string;
      niceToHaveTitle: string;
      missingSuffix: string;
      cardAria: string;
      showDetails: string;
      leadPrefix: string;
      estimate: string;
      estimateTitle: string;
      matchWord: string;
      paidPrefix: string;
      filteredOut: string;
      noneHtml: string;
    };
  }

  const qi = JSON.parse(document.getElementById("quiz-i18n")!.textContent!) as QuizClientI18n;
  const all = (JSON.parse(document.getElementById("browser-data")!.textContent!) as { browsers: Browser[] }).browsers;
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const form = $<HTMLFormElement>("#quiz");
  const layout = $("#layout");
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>(".step")];
  const back = $<HTMLButtonElement>("#back"), next = $<HTMLButtonElement>("#next");
  const LAST = steps.length - 1;
  let state: QuizState = defaultState();
  let step = 0, reached = 0; // furthest step visited, for the clickable stepper
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fmt = (s: string, vars: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ""));

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const initials = (n: string) => n.replace(/[^A-Za-z0-9 ]/g, "").split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase();
  const fitText = (n: number) => `${formatCount(n, qi.js.browsersWord, qi.lang)} ${qi.js.fitSuffix}`;
  const resultsMode = () => layout.dataset.mode === "results";

  // ---- state <-> controls --------------------------------------------------
  function paintControls() {
    form.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((i) => (i.checked = state[i.name as "os" | "ext"] === i.value));
    for (const s of SLIDERS) {
      const input = $<HTMLInputElement>(`#sl-${s.id}`), v = state.sliders[s.id];
      input.value = String(v);
      input.style.setProperty("--pct", `${v * 25}%`);
      input.setAttribute("aria-valuetext", qi.importance[v]);
      $(`#out-${s.id}`).textContent = qi.importance[v];
      $(`[data-sl="${s.id}"]`).dataset.level = String(v);
    }
    for (const f of FEATURES) {
      const v = state.features[f.id] ?? 0;
      form.querySelectorAll<HTMLInputElement>(`input[name="f-${f.id}"]`).forEach((i) => (i.checked = +i.value === v));
      form.querySelector<HTMLElement>(`[data-frow="${f.id}"]`)!.dataset.state = String(v);
    }
    form.querySelectorAll<HTMLInputElement>('input[name="avoid"]').forEach((i) => (i.checked = state.avoid.includes(i.value as AvoidId)));
  }

  function changed() {
    history.replaceState(null, "", `#${encode(state)}${resultsMode() ? "&r=1" : ""}`);
    paintControls();
    const r = rank(all, state, qi.lang);
    countTo(r.results.length);
    renderFaces(state.os ? r.results.slice(0, 5).map((x) => x.browser) : []); // no "leaders" before you've answered anything
    // How many browsers would remain if each feature were a must-have (given everything else you picked).
    for (const f of FEATURES) {
      const n = state.features[f.id] === 2 ? r.results.length : rank(all, { ...state, features: { ...state.features, [f.id]: 2 } }, qi.lang).results.length;
      const el = form.querySelector<HTMLElement>(`[data-frow="${f.id}"] .left`)!;
      el.textContent = fmt(qi.js.leftCount, { n });
      el.classList.toggle("zero", n === 0);
      form.querySelector<HTMLInputElement>(`input[name="f-${f.id}"][value="2"]`)!.setAttribute("aria-description", fmt(qi.js.leftAria, { n }));
    }
    next.disabled = (step === 0 && !state.os) || (step === 1 && !state.ext);
    if (resultsMode()) renderResults(r);
  }

  // Animated "N browsers fit" counter.
  let shownCount = -1, countRaf = 0;
  function countTo(n: number) {
    const el = $("#live");
    if (shownCount < 0 || reduceMotion) { shownCount = n; el.textContent = fitText(n); return; }
    const from = shownCount, t0 = performance.now();
    cancelAnimationFrame(countRaf);
    const tick = (t: number) => {
      const k = Math.min(1, (t - t0) / 350), v = Math.round(from + (n - from) * (1 - (1 - k) ** 3));
      el.textContent = fitText(v);
      if (k < 1) countRaf = requestAnimationFrame(tick); else shownCount = n;
    };
    countRaf = requestAnimationFrame(tick);
  }
  // Tiny logos of the current leaders; only re-rendered when the set changes so they don't flicker.
  let facesKey = "";
  function renderFaces(list: Browser[]) {
    const key = list.map((b) => b.id).join();
    if (key === facesKey) return;
    facesKey = key;
    $("#faces").innerHTML = list.map((b, i) => b.logo
      ? `<img src="${esc(b.logo)}" alt="" width="22" height="22" style="--i:${i}" title="${esc(b.name)}">`
      : `<span class="fm" style="--i:${i}">${esc(initials(b.name))}</span>`).join("");
  }

  form.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.type === "radio" && t.name.startsWith("f-")) {
      const id = t.name.slice(2) as FeatureId, v = +t.value;
      if (v) state.features[id] = v as 1 | 2; else delete state.features[id];
      changed();
    } else if (t.type === "radio") {
      state[t.name as "os" | "ext"] = t.value;
      changed();
      if (!resultsMode()) setTimeout(() => show(step + 1), 260); // pick questions advance on their own
    } else if (t.name === "avoid") {
      state.avoid = [...form.querySelectorAll<HTMLInputElement>('input[name="avoid"]:checked')].map((i) => i.value as AvoidId);
      changed();
    }
  });
  form.addEventListener("input", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.slider) { state.sliders[t.dataset.slider as SliderId] = +t.value; changed(); }
  });

  // ---- step navigation ------------------------------------------------------
  function show(i: number, focus = true) {
    if (i > LAST) return showResults();
    const prev = step, wasResults = resultsMode();
    layout.dataset.mode = "steps";
    step = Math.max(0, i);
    reached = Math.max(reached, step);
    steps.forEach((s, j) => (s.hidden = j !== step));
    // Slide in from the direction of travel.
    const el = steps[step];
    el.classList.remove("in-fwd", "in-back");
    void el.offsetWidth; // restart the animation
    el.classList.add(wasResults || step >= prev ? "in-fwd" : "in-back");
    $<HTMLElement>("#results").hidden = true;
    back.disabled = step === 0;
    back.style.visibility = step === 0 ? "hidden" : "";
    next.innerHTML = step === LAST ? esc(qi.showMatchesLabel) : `${esc(qi.nextLabel)}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><use href="#i-ArrowRight01Icon"/></svg>`;
    next.classList.toggle("finish", step === LAST);
    form.querySelectorAll<HTMLButtonElement>("[data-goto]").forEach((b) => {
      const j = +b.dataset.goto!;
      b.disabled = j > reached || (j > 1 && (!state.os || !state.ext));
      b.parentElement!.classList.toggle("done", j < step);
      b.parentElement!.classList.toggle("current", j === step);
      if (j === step) b.setAttribute("aria-current", "step"); else b.removeAttribute("aria-current");
    });
    form.style.setProperty("--progress", String(step / LAST));
    $("#hint").textContent = qi.js.hints[step];
    changed();
    if (focus) el.querySelector<HTMLElement>("input:checked, input:not([disabled]), button")?.focus({ preventScroll: true });
  }
  function showResults() {
    layout.dataset.mode = "results";
    steps.forEach((s) => { s.hidden = false; s.classList.remove("in-fwd", "in-back"); });
    const res = $<HTMLElement>("#results");
    res.hidden = false;
    res.classList.add("reveal"); // staggered entrance only when arriving, not on every live update
    setTimeout(() => res.classList.remove("reveal"), 1200);
    changed();
    $("#res-title").focus({ preventScroll: true });
    window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
  }
  back.addEventListener("click", () => show(step - 1));
  $("#tune").addEventListener("click", () => {
    const open = form.classList.toggle("open");
    $("#tune").setAttribute("aria-expanded", String(open));
  });
  form.addEventListener("click", (e) => {
    const g = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-goto]");
    if (g && !g.disabled) show(+g.dataset.goto!);
  });
  // Keyboard: 1-3 picks on the pick steps, Enter moves on (unless a button/link already handles it).
  document.addEventListener("keydown", (e) => {
    if (resultsMode() || e.altKey || e.ctrlKey || e.metaKey || document.querySelector("dialog[open]")) return;
    const t = e.target as HTMLElement;
    if (step <= 1 && /^[1-4]$/.test(e.key)) {
      const opts = steps[step].querySelectorAll<HTMLInputElement>('input[type="radio"]');
      const o = opts[+e.key - 1];
      if (o) { e.preventDefault(); o.checked = true; o.dispatchEvent(new Event("change", { bubbles: true })); }
    } else if (e.key === "Enter" && !t.closest("button, a, summary") && !next.disabled) {
      e.preventDefault(); show(step + 1);
    }
  });
  next.addEventListener("click", () => show(step + 1));
  $("#restart").addEventListener("click", () => { state = defaultState(); history.replaceState(null, "", location.pathname); show(0); });

  // ---- results ------------------------------------------------------------
  function card(r: Result, big: boolean) {
    const b = r.browser, size = big ? 48 : 32;
    const logo = b.logo ? `<img src="${esc(b.logo)}" alt="" width="${size}" height="${size}">` : `<span class="mono">${esc(initials(b.name))}</span>`;
    const why = r.reasons.length ? `<ul class="why">${r.reasons.map((x) => `<li>${esc(x)}</li>`).join("")}</ul>` : "";
    const wanted = r.wanted.length
      ? `<ul class="wanted">${r.wanted.map((w) => w.must
          ? `<li class="must" title="${esc(qi.js.mustHaveTitle)}">✓ ${esc(w.label)}${w.detail ? ` <b>${esc(w.detail)}</b>` : ""}</li>`
          : `<li class="${w.ok ? "ok" : "no"}" title="${esc(qi.js.niceToHaveTitle)}${w.ok ? "" : esc(qi.js.missingSuffix)}">${w.ok ? "✓" : "✗"} ${esc(w.label)}${w.ok && w.detail ? ` <b>${esc(w.detail)}</b>` : ""}</li>`).join("")}</ul>` : "";
    return `<li><button type="button" class="res${big ? " big" : ""}" data-open="${esc(b.id)}" aria-haspopup="dialog" aria-label="${esc(fmt(qi.js.cardAria, { name: b.name, match: r.match }))}">
      <span class="rlogo">${logo}</span>
      <span class="rbody">
        ${r.lead ? `<span class="lead">${esc(fmt(qi.js.leadPrefix, { lead: r.lead }))}</span>` : ""}
        <span class="rname">${esc(b.name)}${b.scores.lowConfidence ? ` <span class="est" title="${esc(qi.js.estimateTitle)}">${esc(qi.js.estimate)}</span>` : ""}</span>
        <span class="match"><span class="mbar"><i style="width:${r.match}%"></i></span>${esc(fmt(qi.js.matchWord, { match: r.match }))}</span>
        ${big ? `<span class="rdesc">${esc(b.description)}</span>` : ""}${why}${wanted}
        ${r.paid ? `<span class="paid">${esc(fmt(qi.js.paidPrefix, { paid: r.paid }))}</span>` : ""}
      </span></button></li>`;
  }
  function renderResults(r = rank(all, state, qi.lang)) {
    const { results, excluded } = r;
    $("#top").innerHTML = results.slice(0, 3).map((x) => card(x, true)).join("");
    $("#more").innerHTML = results.slice(3, 9).map((x) => card(x, false)).join("");
    document.querySelectorAll<HTMLElement>("#top > li, #more > li").forEach((li, i) => li.style.setProperty("--i", String(i)));
    $("#more-title").hidden = results.length <= 3;
    const baseFit = fitText(results.length);
    $("#excluded").textContent = excluded.length
      ? `${baseFit}. ${fmt(qi.js.filteredOut, { list: excluded.map((e) => `${e.count} ${e.why}`).join(" · ") })}`
      : `${baseFit}.`;
    const none = $("#none");
    none.hidden = results.length > 0;
    if (!results.length) none.innerHTML = qi.js.noneHtml.replace("{why}", esc(excluded[0]?.why ?? ""));
  }
  $("#results").addEventListener("click", (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>("[data-open]");
    if (t) openBrowser(t.dataset.open!);
  });

  // ---- shareable personality card ---------------------------------------------
  const shareCard = initShareCard(() => ({
    state: structuredClone(state), ranking: rank(all, state, qi.lang), total: all.length,
    url: `${location.origin}${qi.quizPath}#${encode(state)}&r=1`,
    lang: qi.lang,
  }));
  $("#share-open").addEventListener("click", () => shareCard.open());

  // ---- restore from URL -------------------------------------------------------
  const hash = location.hash.slice(1);
  state = decode(hash);
  paintControls();
  if (new URLSearchParams(hash).get("r") === "1" && state.os && state.ext) showResults();
  else show(!state.os ? 0 : !state.ext ? 1 : 0, false); // don't grab focus on page load
</script>

<style>
  .dim { color: var(--faint); font-size: 12.5px; }
  .quiz-about { padding-top: 12px; }
  .quiz-about h2:first-child { margin-top: 0; }
  .hero h1 { font-size: clamp(30px, 5vw, 46px); letter-spacing: -0.035em; line-height: 1.05; margin: 0 0 10px; font-weight: 700; }
  .kicker { margin: 0 0 10px; font-size: 11.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .sub { color: var(--muted); margin: 0; font-size: 15px; }

  /* ---------- Steps mode: centered card, one step at a time ---------- */
  .layout[data-mode="steps"] { position: relative; display: flex; flex-direction: column; align-items: center; padding: 56px 0 32px; isolation: isolate; }
  .layout[data-mode="steps"]::before { content: ""; position: absolute; z-index: -1; inset: 0 -20px auto; height: 520px; pointer-events: none;
    background: radial-gradient(600px 300px at 50% 120px, rgb(255 255 255 / .05), transparent 70%); }
  .layout[data-mode="steps"] .hero { text-align: center; max-width: 560px; margin-bottom: 28px; }
  .layout[data-mode="steps"] .quiz { width: 100%; max-width: 680px; padding: 22px 24px 18px; border-radius: 18px; background: rgb(30 30 30 / .85);
    border: 1px solid var(--line-2); box-shadow: 0 30px 80px rgb(0 0 0 / .45), inset 0 1px 0 rgb(255 255 255 / .04); backdrop-filter: blur(8px); }
  .layout[data-mode="steps"] legend { width: 100%; flex-direction: column; text-align: center; gap: 6px; margin-bottom: 6px; font-size: clamp(20px, 3vw, 25px); }
  .layout[data-mode="steps"] .help { text-align: center; }
  .layout[data-mode="steps"] .chips { justify-content: center; }

  /* Stepper with a filling track */
  .stepper { list-style: none; margin: 0 0 26px; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  .stepper::before, .stepper::after { content: ""; position: absolute; top: 15px; left: 10%; right: 10%; height: 2px; border-radius: 1px; background: var(--bg-3); }
  .stepper::after { right: auto; width: calc(80% * var(--progress)); background: var(--accent); transition: width .45s cubic-bezier(.2,.8,.2,1); }
  .quiz { --progress: 0; }
  .quiz .stepper::after { width: calc(80% * var(--progress)); }
  .stepper li { position: relative; z-index: 1; display: flex; justify-content: center; }
  .stepper button { all: unset; display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; border-radius: 8px; padding: 0 2px; }
  .stepper button:disabled { cursor: default; }
  .stepper button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .dot { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--bg-2); border: 2px solid var(--line-2); color: var(--faint);
    transition: background .25s, border-color .25s, color .25s, transform .25s, box-shadow .25s; }
  .sl { font-size: 11.5px; color: var(--faint); transition: color .25s; }
  .stepper .done .dot { border-color: var(--accent); color: var(--accent); background: var(--bg-2); }
  .stepper .done .sl { color: var(--muted); }
  .stepper .current .dot { background: var(--accent); border-color: var(--accent); color: #111; transform: scale(1.08); box-shadow: 0 0 0 6px rgb(255 255 255 / .08); }
  .stepper .current .sl { color: var(--text); font-weight: 600; }
  .stepper button:not(:disabled):hover .dot { border-color: var(--accent); }

  /* Step transitions */
  .step.in-fwd { animation: in-fwd .42s cubic-bezier(.2,.8,.2,1) both; }
  .step.in-back { animation: in-back .42s cubic-bezier(.2,.8,.2,1) both; }
  @keyframes in-fwd { from { opacity: 0; transform: translateX(28px); } }
  @keyframes in-back { from { opacity: 0; transform: translateX(-28px); } }
  .step.in-fwd .pick, .step.in-fwd .slider, .step.in-fwd .frow, .step.in-fwd .chk { animation: rise .45s cubic-bezier(.2,.8,.2,1) both; }
  .step .pick:nth-child(2), .step .slider:nth-child(2), .step .frow:nth-child(2), .step .chk:nth-child(2) { animation-delay: 40ms; }
  .step .pick:nth-child(3), .step .slider:nth-child(3), .step .frow:nth-child(3), .step .chk:nth-child(3) { animation-delay: 80ms; }
  .step .slider:nth-child(4), .step .frow:nth-child(4), .step .chk:nth-child(4), .step .pick:nth-child(4) { animation-delay: 120ms; }
  .step .slider:nth-child(5), .step .frow:nth-child(5), .step .chk:nth-child(5) { animation-delay: 160ms; }
  .step .frow:nth-child(n+6), .step .chk:nth-child(n+6) { animation-delay: 200ms; }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }

  /* ---------- Results mode: the form becomes a sidebar with every control ---------- */
  .layout[data-mode="results"] { display: grid; grid-template-columns: minmax(300px, 360px) 1fr; gap: 28px; align-items: start; }
  .layout[data-mode="results"] .hero { grid-column: 1 / -1; padding: 40px 0 0; }
  .layout[data-mode="results"] .hero .sub, .layout[data-mode="results"] .stepper, .layout[data-mode="results"] .hint, .layout[data-mode="results"] .key { display: none; }
  .layout[data-mode="results"] .ticon { display: none; }
  .layout[data-mode="results"] .tiles .pick { flex-direction: row; min-height: 0; }
  .layout[data-mode="results"] .quiz { position: sticky; top: 70px; max-height: calc(100dvh - 86px); overflow-y: auto; padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2); display: flex; flex-direction: column; gap: 18px; }
  .layout[data-mode="results"] .nav, .layout[data-mode="results"] .help { display: none; }
  .quiz .tune-title, .quiz .restart { display: none; }
  .tune-title { all: unset; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%; font-weight: 620; }
  .tune-title > span:first-child { display: inline-flex; align-items: center; gap: 8px; }
  .tune-title :global(svg) { color: var(--accent); }
  .chev { display: none; transition: transform .2s; }
  .layout[data-mode="results"] .tune-title { display: flex; cursor: default; }
  .layout[data-mode="results"] .restart { display: inline-flex; align-self: flex-start; }
  .layout[data-mode="results"] legend { font-size: 13px; color: var(--muted); margin-bottom: 8px; }
  .layout[data-mode="results"] .picks { grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .layout[data-mode="results"] .picks.cols-4 { grid-template-columns: repeat(4, 1fr); }
  .layout[data-mode="results"] .pick { padding: 6px 8px; font-size: 12.5px; justify-content: center; text-align: center; }
  .layout[data-mode="results"] .pick small { display: none; }
  .layout[data-mode="results"] .pick input { position: absolute; opacity: 0; pointer-events: none; }
  .layout[data-mode="results"] .sliders { gap: 14px; }
  .layout[data-mode="results"] .slider { padding: 0; background: none; border: 0; }
  .layout[data-mode="results"] .sl-top label[for] { font-size: 13px; }
  .layout[data-mode="results"] .sl-help, .layout[data-mode="results"] .ticks { display: none; }
  .layout[data-mode="results"] .chips { gap: 4px; }
  .layout[data-mode="results"] .chk { font-size: 12px; height: 28px; padding: 0 8px; }
  .layout[data-mode="results"] .n { display: none; }

  .step { border: 0; margin: 0; padding: 0; min-width: 0; }
  .step[hidden] { display: none; }
  legend { display: flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 640; letter-spacing: -0.02em; padding: 0; margin-bottom: 8px; }
  .n { font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); }
  .help { margin: 0 0 14px; color: var(--muted); font-size: 13.5px; }

  /* Pick one */
  .picks { display: grid; gap: 8px; margin-top: 12px; }
  .picks.cols-3 { grid-template-columns: repeat(3, 1fr); }
  .picks.cols-4 { grid-template-columns: repeat(4, 1fr); }
  .pick { display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 10px; background: var(--bg-2); border: 1px solid var(--line); cursor: pointer; transition: border-color .12s, background .12s; }
  .pick:hover { border-color: var(--line-2); }
  .pick:has(input:checked) { border-color: var(--accent); background: var(--accent-bg); }
  .pick:has(input:focus-visible) { outline: 2px dashed var(--muted); outline-offset: 3px; }
  .pick input { accent-color: var(--accent); margin: 0; }
  .pick > span:not(.ticon) { display: flex; flex-direction: column; font-size: 14.5px; }
  .pick small { color: var(--faint); font-size: 12px; }
  .tiles .pick { position: relative; flex-direction: column; justify-content: center; text-align: center; gap: 10px; min-height: 150px; padding: 18px 12px;
    transition: border-color .15s, background .15s, transform .15s, box-shadow .15s; }
  .tiles .pick input { position: absolute; opacity: 0; pointer-events: none; }
  .tiles .pick:has(input:checked) { box-shadow: 0 0 0 4px rgb(255 255 255 / .06); }
  .ticon { width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center; background: var(--bg-3); color: var(--text); transition: background .15s, color .15s, transform .2s; }
  .ticon img { width: 34px; height: 34px; object-fit: contain; }
  .pick:has(input:checked) .ticon { background: var(--accent); color: #111; transform: scale(1.06); }
  .pick:has(input:checked) .ticon img { filter: drop-shadow(0 0 1px rgb(0 0 0 / .4)); }
  .tl { display: flex; flex-direction: column; gap: 4px; font-size: 15px; font-weight: 560; }
  .tl small { font-weight: 400; line-height: 1.35; }
  .key { position: absolute; top: 8px; right: 8px; font: 10.5px var(--mono); color: var(--faint); border: 1px solid var(--line-2); border-radius: 4px; padding: 0 5px; }

  /* Sliders */
  .sliders { display: flex; flex-direction: column; gap: 10px; }
  .slider { padding: 12px 14px; border-radius: 10px; background: var(--bg-2); border: 1px solid var(--line); }
  .sl-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 6px; }
  .sl-top label { font-size: 14px; font-weight: 560; }
  .sl-top label[for] { flex: 1; }
  .sl-help { margin: 0 0 6px; font-size: 12px; color: var(--faint); line-height: 1.4; }
  .ticks { display: flex; justify-content: space-between; margin-top: 2px; font-size: 10.5px; color: var(--faint); }
  .ticks span { width: 20%; text-align: center; }
  .ticks span:first-child { text-align: left; } .ticks span:last-child { text-align: right; }
  .slider[data-level="0"] output { color: var(--faint); }
  .slider[data-level="4"] output { color: var(--ok); font-weight: 600; }
  .slider[data-level="0"] input[type="range"] { --accent: var(--line-2); }
  .sl-top output { font-size: 12.5px; color: var(--accent); text-align: right; }
  input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; height: 22px; background: transparent; cursor: pointer; margin: 0; --pct: 50%; }
  input[type="range"]::-webkit-slider-runnable-track { height: 6px; border-radius: 3px; background: linear-gradient(to right, var(--accent) var(--pct), var(--bg-3) var(--pct)); }
  input[type="range"]::-moz-range-track { height: 6px; border-radius: 3px; background: var(--bg-3); }
  input[type="range"]::-moz-range-progress { height: 6px; border-radius: 3px; background: var(--accent); }
  input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; margin-top: -6px; border-radius: 50%; background: var(--text); border: 3px solid var(--accent); }
  input[type="range"]::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: var(--text); border: 3px solid var(--accent); }
  input[type="range"]:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 4px; }

  /* Multi pick */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chk { display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 12px; border-radius: 8px; background: var(--bg-2); border: 1px solid var(--line); color: var(--muted); font-size: 13.5px; cursor: pointer; user-select: none; }
  .chk:hover { border-color: var(--line-2); color: var(--text); }
  .chk input { position: absolute; opacity: 0; pointer-events: none; }
  .chk svg { opacity: .35; }
  .chk:has(input:checked) { border-color: var(--dead); color: var(--text); background: rgb(248 113 113 / .1); }
  .chk:has(input:checked) svg { opacity: 1; color: var(--dead); }
  .chk:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Must-haves: one row per feature with an explicit 3-way choice */
  .explain { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 0 0 12px; }
  .explain p { margin: 0; padding: 10px 12px; border-radius: 8px; font-size: 12.5px; color: var(--muted); display: flex; flex-direction: column; gap: 2px; }
  .explain b { font-size: 13px; }
  .ex-nice { background: rgb(167 139 250 / .08); border: 1px solid rgb(167 139 250 / .3); } .ex-nice b { color: #c4b5fd; }
  .ex-must { background: rgb(74 222 128 / .08); border: 1px solid rgb(74 222 128 / .3); } .ex-must b { color: var(--ok); }
  .frows { display: flex; flex-direction: column; gap: 4px; }
  .fgroup { margin: 10px 0 2px; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }
  .fgroup:first-child { margin-top: 0; }
  .frow { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; padding: 6px 6px 6px 12px; border-radius: 9px; background: var(--bg-2); border: 1px solid var(--line); }
  .frow[data-state="1"] { border-color: rgb(167 139 250 / .45); }
  .frow[data-state="2"] { border-color: rgb(74 222 128 / .45); }
  .flabel { font-size: 13.5px; }
  .seg3 { display: grid; grid-template-columns: auto minmax(90px, auto) minmax(112px, auto); background: var(--bg); border: 1px solid var(--line); border-radius: 7px; padding: 2px; gap: 2px; }
  .seg3 label { justify-content: center; }
  .seg3 label { position: relative; display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px; border-radius: 5px; font-size: 12.5px; color: var(--muted); cursor: pointer; white-space: nowrap; }
  .seg3 label:hover { color: var(--text); }
  .seg3 input { position: absolute; opacity: 0; pointer-events: none; }
  .seg3 label:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 1px; }
  .seg3 .o0:has(input:checked) { background: var(--bg-3); color: var(--text); }
  .seg3 .o1:has(input:checked) { background: #a78bfa; color: #111; font-weight: 600; }
  .seg3 .o2:has(input:checked) { background: var(--ok); color: #111; font-weight: 600; }
  .left { font-size: 10.5px; font-weight: 500; opacity: .75; font-variant-numeric: tabular-nums; }
  .left.zero { color: var(--dead); opacity: 1; }
  .o2:has(input:checked) .left.zero { color: #7f1d1d; }
  .layout[data-mode="results"] .explain { display: none; }
  .layout[data-mode="results"] .frow { grid-template-columns: 1fr; gap: 4px; padding: 6px; }
  .layout[data-mode="results"] .flabel { font-size: 12.5px; padding-left: 4px; }
  .layout[data-mode="results"] .seg3 { grid-template-columns: auto 1fr 1fr; }
  .layout[data-mode="results"] .seg3 label { padding: 0 6px; font-size: 11.5px; justify-content: center; }
  @media (max-width: 600px) { .explain { grid-template-columns: 1fr; } .frow { grid-template-columns: 1fr; } .seg3 { grid-template-columns: auto 1fr 1fr; } .seg3 label { padding: 0 6px; } }

  .nav { display: flex; align-items: center; gap: 12px; margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--line); }
  .peek { flex: 1; display: flex; align-items: center; justify-content: center; gap: 10px; min-width: 0; }
  .faces { display: flex; }
  .faces img, .faces .fm { width: 24px; height: 24px; border-radius: 50%; object-fit: contain; background: var(--bg-3); border: 2px solid var(--bg-2); padding: 2px; margin-left: -7px;
    animation: pop .35s cubic-bezier(.2,.8,.2,1.4) both; animation-delay: calc(var(--i) * 45ms); }
  .faces .fm { display: grid; place-items: center; font: 600 8px var(--mono); color: var(--muted); }
  .faces > :first-child { margin-left: 0; }
  @keyframes pop { from { opacity: 0; transform: scale(.4); } }
  .live { font-size: 12.5px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hint { margin: 10px 0 0; text-align: center; font-size: 11.5px; color: var(--faint); min-height: 1em; }
  .btn.finish { box-shadow: 0 4px 14px rgb(255 255 255 / .14); }
  .btn { transition: transform .12s, box-shadow .15s, opacity .15s; }
  .btn { display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg-2); color: var(--text); font-size: 13px; cursor: pointer; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #111; font-weight: 600; }
  .btn.ghost { background: none; color: var(--muted); }
  .btn:disabled { opacity: .45; cursor: not-allowed; }
  .btn.primary:disabled { background: var(--bg-3); border-color: var(--line-2); color: var(--faint); box-shadow: none; opacity: 1; }

  /* Results */
  .results[hidden] { display: none; }
  .results.reveal h2, .results.reveal .excluded { animation: rise .4s cubic-bezier(.2,.8,.2,1) both; }
  .results.reveal .top > li, .results.reveal .more > li { animation: rise .5s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(80ms + var(--i, 0) * 60ms); }
  .layout[data-mode="results"] .quiz { animation: rise .4s cubic-bezier(.2,.8,.2,1) both; }
  .results h2 { margin: 0 0 4px; font-size: 20px; outline: none; }
  .excluded { margin: 0 0 14px; }
  .share-cta { all: unset; box-sizing: border-box; position: relative; isolation: isolate; display: flex; align-items: center; gap: 14px; width: 100%; margin: 0 0 16px; padding: 14px 16px; border-radius: 12px; cursor: pointer;
    background: linear-gradient(#0f0f10, #0f0f10) padding-box, linear-gradient(110deg, #7c3aed, #22d3ee, #f472b6, #facc15) border-box; border: 1.5px solid transparent;
    transition: transform .15s var(--ease), box-shadow .2s; }
  .share-cta:hover { transform: translateY(-1px); box-shadow: 0 10px 30px rgb(124 58 237 / .25); }
  .share-cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .share-cta > span:nth-child(2) { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .share-cta b { font-weight: 650; font-size: 14.5px; }
  .share-cta small { color: var(--muted); font-size: 12.5px; }
  .sc-spark { flex: none; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px; font-size: 18px; color: #fff;
    background: linear-gradient(135deg, #7c3aed, #f472b6 60%, #facc15); }
  .results.reveal .share-cta { animation: rise .45s cubic-bezier(.2,.8,.2,1) both; animation-delay: 60ms; }
  .top, .more { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .top { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .more { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .more-title { font-size: 13px; color: var(--muted); font-weight: 600; margin: 24px 0 10px; }
  .more-title[hidden], .none[hidden] { display: none; }
  .none { padding: 20px; border: 1px dashed var(--line-2); border-radius: 10px; color: var(--muted); }
  .results :global(.res) { all: unset; box-sizing: border-box; width: 100%; height: 100%; cursor: pointer; display: flex; gap: 12px; padding: 12px; border-radius: 10px; background: var(--bg-2); border: 1px solid var(--line); }
  .results :global(.res.big) { padding: 16px; border-color: var(--line-2); }
  .results :global(.res:hover) { border-color: var(--accent); }
  .results :global(.res:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .results :global(.rlogo img) { object-fit: contain; filter: drop-shadow(0 0 1px rgb(255 255 255 / .45)); }
  .results :global(.mono) { width: 40px; height: 40px; border-radius: 9px; display: grid; place-items: center; background: var(--bg-3); font: 600 13px var(--mono); color: var(--muted); }
  .results :global(.rbody) { display: flex; flex-direction: column; gap: 5px; min-width: 0; flex: 1; }
  .results :global(.lead) { align-self: flex-start; font-size: 10.5px; font-weight: 600; letter-spacing: .02em; color: var(--ok); background: rgb(74 222 128 / .1); border: 1px solid rgb(74 222 128 / .3); border-radius: 5px; padding: 1px 6px; }
  .results :global(.paid) { align-self: flex-start; font-size: 11.5px; color: var(--warn); background: rgb(251 191 36 / .08); border: 1px solid rgb(251 191 36 / .25); border-radius: 5px; padding: 1px 7px; }
  .results :global(.rname) { font-weight: 620; font-size: 15px; }
  .results :global(.match) { display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .results :global(.mbar) { flex: 1; max-width: 120px; height: 4px; border-radius: 2px; background: var(--bg-3); overflow: hidden; }
  .results :global(.mbar i) { display: block; height: 100%; background: var(--accent); }
  .results :global(.rdesc) { color: var(--muted); font-size: 13px; line-height: 1.45; }
  .results :global(.est) { font-size: 10px; font-weight: 500; color: var(--warn); border: 1px solid rgb(251 191 36 / .35); border-radius: 4px; padding: 0 4px; vertical-align: middle; }
  .results :global(.why), .results :global(.wanted) { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px; }
