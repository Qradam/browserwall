---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

const EMAIL = "ujhazyadam@gmail.com";
const TOPICS = [
  { title: "A mistake in the data", text: "Wrong score, outdated logo, a dead browser marked as alive – tell me which browser and what's off. A link helps." },
  { title: "A missing browser", text: "Name, website and why people use it. It needs to be a usable desktop browser that's actively maintained." },
  { title: "Anything else", text: "Ideas for the quiz or tier maker, bugs, or just hello." },
];
---
<Base title="Contact – browserwall" description="Get in touch about browserwall: corrections, missing browsers, ideas.">
  <section class="contact">
    <p class="kicker">Contact</p>
    <h1>Say hi</h1>
    <p class="sub">browserwall is a one-person project. Corrections and suggestions are very welcome.</p>

    <div class="mail">
      <a class="addr" href={`mailto:${EMAIL}?subject=${encodeURIComponent("browserwall")}`}><Icon name="Mail01Icon" size={18} />{EMAIL}</a>
      <button type="button" class="copy" id="copy" data-email={EMAIL}><Icon name="Copy01Icon" size={14} /><span>Copy</span></button>
    </div>

    <ul class="topics">
      {TOPICS.map((t) => <li><h2>{t.title}</h2><p>{t.text}</p></li>)}
    </ul>
  </section>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>("#copy")!;
  btn.addEventListener("click", async () => {
    const label = btn.querySelector("span")!;
    try { await navigator.clipboard.writeText(btn.dataset.email!); label.textContent = "Copied"; }
    catch { label.textContent = "Copy failed"; }
    setTimeout(() => (label.textContent = "Copy"), 1800);
  });
</script>

<style>
  .contact { max-width: 620px; margin: 0 auto; padding: 72px 0 40px; text-align: center; }
  .kicker { margin: 0 0 10px; font-size: 11.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  h1 { font-size: clamp(30px, 5vw, 46px); letter-spacing: -0.035em; line-height: 1.05; margin: 0 0 10px; font-weight: 700; }
  .sub { color: var(--muted); margin: 0 0 28px; font-size: 15px; }
  .mail { display: inline-flex; align-items: center; gap: 6px; padding: 6px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line-2); box-shadow: 0 20px 60px rgb(0 0 0 / .35); max-width: 100%; }
  .addr { display: inline-flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 9px; text-decoration: none; font-size: 16px; font-weight: 560; overflow-wrap: anywhere; }
  .addr :global(svg) { color: var(--accent); flex: none; }
  .addr:hover { background: var(--bg-3); }
  .copy { display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 12px; border-radius: 9px; border: 0; background: var(--accent); color: #111; font-size: 13px; font-weight: 600; cursor: pointer; flex: none; }
  .copy:hover { filter: brightness(1.08); }
  .topics { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; text-align: left; }
  .topics li { padding: 14px; border-radius: 10px; background: var(--bg-2); border: 1px solid var(--line); }
  .topics h2 { margin: 0 0 6px; font-size: 13.5px; font-weight: 620; }
  .topics p { margin: 0; color: var(--muted); font-size: 12.5px; line-height: 1.5; }
  @media (max-width: 640px) { .topics { grid-template-columns: 1fr; } .mail { flex-direction: column; align-items: stretch; } .copy { justify-content: center; } }
</style>
