---
import "../../styles/content.css";
import "../../styles/compare.css";
import Base from "../../layouts/Base.astro";
import QuizCta from "../../components/QuizCta.astro";
import Crumbs from "../../components/Crumbs.astro";
import Icon from "../../components/Icon.astro";
import { browsers, byId } from "../../data/browsers";
import { COMPARISONS, comparisonOf, YEAR, UPDATED, breadcrumbLd, faqLd, seoTitle } from "../../lib/seo";
import { compareRows, chooseIf } from "../../lib/compare";

const MAX = 4;
const DEFAULT = ["brave", "firefox"];
const initial = DEFAULT.map((id) => byId.get(id)!);
const rows = compareRows(initial);
const why = [chooseIf(initial[0], initial[1]), chooseIf(initial[1], initial[0])];
const full = comparisonOf(DEFAULT[0], DEFAULT[1]);

const popular = browsers.filter((b) => b.usageRank != null);
const rest = browsers.filter((b) => b.usageRank == null).sort((a, b) => a.name.localeCompare(b.name));
// Only what the client needs to rebuild the table (see src/lib/compare.ts).
const payload = JSON.stringify({
  browsers: browsers.map(({ id, name, logo, engine, basedOn, os, status, openSource, tags, scores, price, ai, usageRank }) =>
    ({ id, name, logo, engine, basedOn, os, status, openSource, tags, scores, price, ai, usageRank })),
  pages: COMPARISONS.map((c) => [c.a.id, c.b.id, c.slug, `${c.a.name} vs ${c.b.name}`]),
}).replace(/</g, "\\u003c");

const faq = [
  { q: "How are browsers compared?", a: "Every browser gets five hand-checked 1–5 scores – privacy, out-of-box experience, customisation, lightness and minimalism – plus facts like supported systems, engine, extension store, price, source code and built-in AI. The table marks the best value in each row; the \"choose if\" lists come from the biggest differences." },
  { q: "Why is there no speed score?", a: "Mainstream browsers are within benchmark noise of each other on speed, and results change with every release. Lightness (RAM and CPU footprint) matters more day to day, so that's what we score." },
  { q: "Which browser is the best overall?", a: "It depends on your OS, the extensions you need and how much you care about privacy versus polish. The browser quiz weighs all of that and gives you a ranked shortlist in about two minutes." },
];
const crumbs = [{ name: "Compare", href: "/compare" }];
const title = seoTitle(`Compare browsers side by side (${YEAR})`, `Compare browsers (${YEAR})`);
const description = `Compare up to four desktop browsers side by side: privacy, polish, customisation, RAM use, extensions, AI and price. Plus head-to-heads like Chrome vs Firefox and Brave vs Chrome. Updated ${UPDATED}.`;
---
<Base title={title} description={description} jsonLd={[breadcrumbLd(Astro.site, crumbs), faqLd(faq)]} dialog={false}>
  <div class="doc">
    <Crumbs items={crumbs} />
    <p class="kicker">Compare</p>
    <h1>Compare browsers side by side</h1>
    <p class="lede">Pick two to four browsers to see how they stack up on privacy, polish, customisation, RAM use, extensions, AI and price. Updated {UPDATED}.</p>

    <script id="cmp-data" type="application/json" set:html={payload} />
    <section class="cmp-picker" aria-labelledby="cmp-pick-h">
      <div class="cmp-tray-row">
        <h2 id="cmp-pick-h" class="sr">Pick browsers</h2>
        <ol class="cmp-tray" id="cmp-tray" aria-label="Selected browsers">
          {Array.from({ length: MAX }, (_, i) => {
            const b = initial[i];
            return b
              ? <li class="full"><img src={b.logo ?? ""} alt="" width="28" height="28" /><span>{b.name}</span><button type="button" data-remove={b.id} aria-label={`Remove ${b.name}`}><Icon name="Cancel01Icon" size={14} /></button></li>
              : <li class="empty"><span>{i < 2 ? "Pick a browser" : "Optional"}</span></li>;
          })}
        </ol>
        <label class="cmp-search"><Icon name="Search01Icon" size={15} /><span class="sr">Search browsers</span><input id="cmp-q" type="search" placeholder="Search browsers" autocomplete="off" /></label>
      </div>
      <p class="cmp-hint" id="cmp-hint" aria-live="polite">Click up to {MAX} browsers. Click again to remove.</p>
      <ul class="cmp-grid" id="cmp-grid">
        {[...popular, ...rest].map((b) => (
          <li class:list={[{ more: b.usageRank == null, dead: b.status === "discontinued" }]} data-name={b.name.toLowerCase()}>
            <button type="button" data-id={b.id} aria-pressed={DEFAULT.includes(b.id) ? "true" : "false"} title={b.name}>
              {b.logo ? <img src={b.logo} alt="" width="40" height="40" loading="lazy" /> : <span class="mono">{b.name.slice(0, 2).toUpperCase()}</span>}
              <span class="nm">{b.name}</span>
              <span class="ck" aria-hidden="true"><Icon name="Tick02Icon" size={12} /></span>
            </button>
          </li>
        ))}
      </ul>
      <button type="button" class="cmp-more" id="cmp-more" aria-expanded="false" aria-controls="cmp-grid">Show all {browsers.length} browsers</button>
    </section>

    <div class="tbl-wrap" aria-live="polite">
      <table class="cmp" id="cmp-table">
        <thead><tr class="cmp-head"><th scope="col"><span class="sr">Category</span></th>{initial.map((b) => <th scope="col"><a href={`/browsers/${b.id}`}>{b.logo && <img src={b.logo} alt="" width="36" height="36" />}{b.name}</a></th>)}</tr></thead>
        <tbody>{rows.map((r) => <tr class={r.group}><th scope="row">{r.label}</th>{r.values.map((v, i) => <td class={r.best.includes(i) ? "win" : undefined}>{r.best.includes(i) && <Icon name="Tick02Icon" size={13} label="Better" />}{v}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <p class="cmp-full" id="cmp-full">{full && <a href={`/compare/${full.slug}`}>Read the full {full.a.name} vs {full.b.name} comparison →</a>}</p>
    <div class="vs-pick" id="cmp-why">
      {initial.map((b, i) => <section><h3>Choose {b.name} if…</h3><ul class="prose">{why[i].map((r) => <li>{r.charAt(0).toUpperCase() + r.slice(1)}</li>)}</ul></section>)}
    </div>

    <h2>Popular comparisons</h2>
    <ul class="linkgrid">{COMPARISONS.map((c) => <li><a href={`/compare/${c.slug}`}>{c.a.logo && <img src={c.a.logo} alt="" width="24" height="24" loading="lazy" />}<span>{c.a.name} vs {c.b.name}</span></a></li>)}</ul>

    <QuizCta />
    <h2>FAQ</h2>
    <div class="faq">{faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </div>
</Base>

<script>
  import { compareRows, chooseIf } from "../../lib/compare";
  import type { Browser } from "../../data/browsers";

  const MAX = 4;
  const data = JSON.parse(document.getElementById("cmp-data")!.textContent!) as { browsers: Browser[]; pages: [string, string, string, string][] };
  const byId = new Map(data.browsers.map((b) => [b.id, b]));
  const grid = document.getElementById("cmp-grid")!;
  const tray = document.getElementById("cmp-tray")!;
  const hint = document.getElementById("cmp-hint")!;
  const q = document.getElementById("cmp-q") as HTMLInputElement;
  const more = document.getElementById("cmp-more") as HTMLButtonElement;
  const table = document.getElementById("cmp-table")!;
  const fullEl = document.getElementById("cmp-full")!;
  const whyEl = document.getElementById("cmp-why")!;
  const tick = table.querySelector("td.win svg")?.outerHTML ?? "";
  const cross = tray.querySelector("button svg")?.outerHTML ?? "×";
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
  const HINT = hint.textContent!;

  let picked: string[] = [...tray.querySelectorAll<HTMLButtonElement>("button[data-remove]")].map((b) => b.dataset.remove!);

  function toggle(id: string) {
    if (picked.includes(id)) picked = picked.filter((x) => x !== id);
    else if (picked.length >= MAX) { hint.textContent = `You can compare up to ${MAX} browsers. Remove one first.`; hint.classList.add("warn"); return; }
    else picked = [...picked, id];
    render();
  }

  function render() {
    hint.classList.remove("warn");
    hint.textContent = picked.length < 2 ? "Pick at least two browsers to compare." : HINT;
    for (const btn of grid.querySelectorAll<HTMLButtonElement>("button")) btn.setAttribute("aria-pressed", String(picked.includes(btn.dataset.id!)));
    grid.classList.toggle("is-full", picked.length >= MAX);
    const list = picked.map((id) => byId.get(id)!);
    tray.innerHTML = Array.from({ length: MAX }, (_, i) => {
      const b = list[i];
      return b ? `<li class="full">${b.logo ? `<img src="${esc(b.logo)}" alt="" width="28" height="28">` : ""}<span>${esc(b.name)}</span><button type="button" data-remove="${esc(b.id)}" aria-label="Remove ${esc(b.name)}">${cross}</button></li>`
        : `<li class="empty"><span>${i < 2 ? "Pick a browser" : "Optional"}</span></li>`;
    }).join("");

    const rows = compareRows(list);
    table.closest(".tbl-wrap")!.toggleAttribute("hidden", list.length < 1);
    table.innerHTML = `<thead><tr class="cmp-head"><th scope="col"><span class="sr">Category</span></th>${list.map((b) =>
      `<th scope="col"><a href="/browsers/${esc(b.id)}">${b.logo ? `<img src="${esc(b.logo)}" alt="" width="36" height="36">` : ""}${esc(b.name)}</a></th>`).join("")}</tr></thead>
      <tbody>${rows.map((r) => `<tr class="${r.group}"><th scope="row">${esc(r.label)}</th>${r.values.map((v, i) =>
        r.best.includes(i) ? `<td class="win">${tick}${esc(v)}</td>` : `<td>${esc(v)}</td>`).join("")}</tr>`).join("")}</tbody>`;
    const page = list.length === 2 && data.pages.find(([a, b]) => (a === list[0].id && b === list[1].id) || (a === list[1].id && b === list[0].id));
    fullEl.innerHTML = page ? `<a href="/compare/${esc(page[2])}">Read the full ${esc(page[3])} comparison →</a>` : "";
    whyEl.innerHTML = list.length === 2 ? list.map((b, i) => {
      const r = chooseIf(b, list[1 - i]);
      return `<section><h3>Choose ${esc(b.name)} if…</h3>${r.length ? `<ul class="prose">${r.map((x) => `<li>${esc(cap(x))}</li>`).join("")}</ul>`
        : `<p class="prose">It doesn't clearly beat ${esc(list[1 - i].name)} on anything we score.</p>`}</section>`;
    }).join("") : "";
    history.replaceState(null, "", list.length ? `#${list.map((b) => b.id).join(",")}` : location.pathname);
  }

  grid.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>("button[data-id]");
    if (btn) toggle(btn.dataset.id!);
  });
  tray.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>("button[data-remove]");
    if (btn) toggle(btn.dataset.remove!);
  });
  more.addEventListener("click", () => {
    const open = grid.classList.toggle("show-all");
    more.setAttribute("aria-expanded", String(open));
    more.textContent = open ? "Show fewer" : `Show all ${data.browsers.length} browsers`;
  });
  q.addEventListener("input", () => {
    const term = q.value.trim().toLowerCase();
    grid.classList.toggle("searching", !!term);
    for (const li of grid.querySelectorAll<HTMLElement>("li")) li.hidden = !!term && !li.dataset.name!.includes(term);
  });

  // Shared links: /compare#brave,firefox,vivaldi
  const fromHash = [...new Set(decodeURIComponent(location.hash.slice(1)).split(","))].filter((id) => byId.has(id)).slice(0, MAX);
  if (fromHash.length) { picked = fromHash; render(); }
</script>
