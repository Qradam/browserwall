  { name: "Helium 0.22.0 release notes – GitHub", href: "https://github.com/imputnet/helium/releases/tag/0.22.0" },
  { name: "Helium 0.22.2 upgrades pinned tabs – PiunikaWeb", href: "https://piunikaweb.com/2026/11/21/helium-browser-update-pinned-tabs-redesigns-vertical-tabs/" },
