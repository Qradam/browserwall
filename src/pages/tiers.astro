---
import Base from "../layouts/Base.astro";
import { tiers, byId } from "../data/browsers";

const ranked = tiers.filter((t) => !t.unranked);
const other = tiers.filter((t) => t.unranked);
const initials = (n: string) => n.replace(/[^A-Za-z0-9 ]/g, "").split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase();
---
<Base title="Browser Tier List – browserwall" description="An opinionated tier list of desktop web browsers in 2026, from S to skip.">
  <section class="hero">
    <h1>Tier list</h1>
    <p>How good each browser is as a <strong>daily driver</strong> in late 2026: defaults, maintenance, features and trust. It's our opinion, not a benchmark. Hover a logo for its name, click it to find it on the wall.</p>
  </section>

  {[ranked, other].map((group, gi) => (
    <div class={`board${gi ? " unranked" : ""}`}>
      {group.map((t) => (
        <section class={`row tier-${t.id}`} aria-labelledby={`t-${t.id}`}>
          <div class="label"><span id={`t-${t.id}`}>{t.label}</span></div>
          <div class="body">
            <header>
              <h2>{t.title}</h2>
              <p>{t.blurb}</p>
            </header>
            <ul class="items">
              {t.ids.map((id) => {
                const b = byId.get(id)!;
                const note = t.notes?.[id];
                return (
                  <li>
                    <a href={`/?q=${encodeURIComponent(b.name)}`} class="item" title={note ? `${b.name}: ${note}` : b.name}>
                      {b.logo ? <img src={b.logo} alt="" width="44" height="44" loading="lazy" decoding="async" /> : <span class="mono">{initials(b.name)}</span>}
                      <span class="name">{b.name}</span>
                    </a>
                    {note && <p class="note">{note}</p>}
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      ))}
    </div>
  ))}
</Base>

<style>
  .hero { padding: 48px 0 24px; max-width: 720px; }
  h1 { font-size: clamp(28px, 4vw, 40px); letter-spacing: -0.03em; margin: 0 0 10px; font-weight: 680; }
  .hero p { color: var(--muted); margin: 0; font-size: 15px; }
  .hero strong { color: var(--text); font-weight: 600; }

  .board { display: flex; flex-direction: column; gap: 8px; margin-bottom: 28px; }
  .row { display: grid; grid-template-columns: 72px 1fr; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--bg-2); }
  .label { display: grid; place-items: center; font: 750 26px var(--font); letter-spacing: -0.02em; color: #111; background: var(--tier, var(--bg-3)); }
  .tier-S { --tier: #ff7f7f; } .tier-A { --tier: #ffbf7f; } .tier-B { --tier: #ffdf7f; }
  .tier-C { --tier: #bfff7f; } .tier-D { --tier: #7fbfff; }
  .unranked .label { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); background: var(--bg-3); }
  .body { padding: 12px 14px; min-width: 0; }
  header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin-bottom: 10px; }
  h2 { margin: 0; font-size: 14px; font-weight: 620; }
  header p { margin: 0; color: var(--faint); font-size: 12.5px; }

  .items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .items li { display: flex; flex-direction: column; max-width: 260px; }
  .item { display: flex; align-items: center; gap: 8px; padding: 5px 10px 5px 5px; border-radius: 8px; text-decoration: none; background: var(--bg-3); border: 1px solid transparent; transition: border-color .12s; }
  .item:hover { border-color: var(--line-2); }
  .item img, .mono { width: 28px; height: 28px; object-fit: contain; flex: none; }
  .mono { display: grid; place-items: center; border-radius: 7px; background: var(--bg); font: 600 11px var(--mono); color: var(--muted); }
  .name { font-size: 12.5px; white-space: nowrap; }
  .note { margin: 4px 2px 0; font-size: 11.5px; color: var(--faint); line-height: 1.4; }
  .tier-rip img { filter: grayscale(1); opacity: .8; }

  @media (max-width: 560px) { .row { grid-template-columns: 48px 1fr; } .label { font-size: 20px; } .unranked .label { font-size: 9px; writing-mode: vertical-rl; } }
</style>
