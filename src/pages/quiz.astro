  .results :global(.mono) { width: 40px; height: 40px; border-radius: 9px; display: grid; place-items: center; background: var(--bg-3); font: 600 13px var(--mono); color: var(--muted); }
  .results :global(.rbody) { display: flex; flex-direction: column; gap: 5px; min-width: 0; flex: 1; }
  .results :global(.lead) { align-self: flex-start; font-size: 10.5px; font-weight: 600; letter-spacing: .02em; color: var(--ok); background: rgb(74 222 128 / .1); border: 1px solid rgb(74 222 128 / .3); border-radius: 5px; padding: 1px 6px; }
  .results :global(.paid) { align-self: flex-start; font-size: 11.5px; color: var(--warn); background: rgb(251 191 36 / .08); border: 1px solid rgb(251 191 36 / .25); border-radius: 5px; padding: 1px 7px; }
