---
import "../../styles/content.css";
import Base from "../../layouts/Base.astro";
import QuizCta from "../../components/QuizCta.astro";
import Crumbs from "../../components/Crumbs.astro";
import RankedList, { type Item } from "../../components/RankedList.astro";
import { byId, type Browser } from "../../data/browsers";
import { ALTERNATIVE_IDS, alternativesFor, YEAR, UPDATED, breadcrumbLd, faqLd, itemListLd, seoTitle } from "../../lib/seo";

const crumbs = [{ name: "Alternatives", href: "/alternatives" }];
const list = ALTERNATIVE_IDS.map((id) => {
  const b = byId.get(id)!;
  const alts = alternativesFor(b, 5);
  return { b, alts, top: alts.slice(0, 3).map((a) => a.result.browser.name).join(", ") };
});

// Answer first: the browsers that come up most often as replacements across every "X alternatives" page.
// Points by position (5 for 1st … 1 for 5th), weighted up for the browsers most people leave (wall order = usage).
const tally = new Map<string, { b: Browser; pts: number; replaces: Browser[] }>();
for (const { b: src, alts } of list) {
  const weight = src.usageRank != null ? 1 + (30 - Math.min(src.usageRank, 30)) / 15 : 1;
  alts.forEach((a, i) => {
    const t = tally.get(a.result.browser.id) ?? { b: a.result.browser, pts: 0, replaces: [] };
    t.pts += (5 - i) * weight;
    if (i < 3) t.replaces.push(src);
    tally.set(a.result.browser.id, t);
  });
}
const picks = [...tally.values()].sort((a, b) => b.pts - a.pts).slice(0, 6);
const items: Item[] = picks.map(({ b, replaces }) => ({
  b,
  badges: b.scores.lowConfidence ? ["estimate"] : [],
  lines: [
    ...(replaces.length ? [{ label: "Recommended instead of:", text: replaces.slice(0, 6).map((x) => x.name).join(", ") + (replaces.length > 6 ? ` +${replaces.length - 6} more` : ""), tone: "good" as const }] : []),
    ...(b.price ? [{ label: "Price:", text: b.price.note, tone: "warn" as const }] : []),
  ],
}));
const QUICK = ["google-chrome", "microsoft-edge", "safari", "firefox", "opera", "brave", "arc", "chatgpt-atlas"];
const quick = QUICK.map((id) => list.find((x) => x.b.id === id)).filter((x) => x && x.alts[0]) as typeof list;
const topNames = picks.slice(0, 3).map((p) => p.b.name);
const faq = [
  { q: "What is the best alternative to Chrome?", a: `For most people: ${list.find((x) => x.b.id === "google-chrome")?.top ?? "Brave, Firefox and Vivaldi"}. Chromium-based alternatives keep your Chrome Web Store extensions; Firefox-based ones also run the full uBlock Origin.` },
  { q: "Will I lose my bookmarks and passwords if I switch?", a: "No. Almost every browser offers to import bookmarks, saved passwords, history and open tabs from your old browser on first launch. Extensions carry over only within the same store: Chromium browsers share the Chrome Web Store, Firefox forks share Firefox Add-ons." },
  { q: "Why switch browsers at all?", a: "The most common reasons are privacy (an owner that earns money from your data), bloat (AI sidebars, shopping and news feeds, VPN upsells), resource use, a browser being discontinued, and missing features such as vertical tabs, workspaces or a built-in ad blocker." },
];
---
<Base title={seoTitle(`Best browser alternatives (${YEAR}): ${topNames.slice(0, 2).join(", ")} & more`, `Best browser alternatives ${YEAR}`, `Browser alternatives ${YEAR}`)} description={`The best browser alternatives in ${YEAR} are ${topNames.join(", ")}. See what to switch to from Chrome, Edge, Safari, Firefox, Opera, Arc and more – ranked by what each does better. Updated ${UPDATED}.`} jsonLd={[itemListLd(Astro.site, `Best browser alternatives ${YEAR}`, picks.map((p) => p.b)), breadcrumbLd(Astro.site, crumbs), faqLd(faq)]} dialog={false}>
  <div class="doc">
    <Crumbs items={crumbs} />
    <p class="kicker">Alternatives</p>
    <h1>The best browser alternatives in {YEAR}</h1>
    <p class="lede">The browsers people switch to most are <b>{topNames.join(", ").replace(/, ([^,]*)$/, " and $1")}</b>. They come up most often as replacements across our {list.length} alternatives pages, weighted towards the browsers most people use. Leaving a specific browser? Jump to <a href="#leaving">what to switch to from yours</a>. Updated {UPDATED}.</p>

    <h2>Top browser alternatives</h2>
    <RankedList items={items} />

    <h2 id="quick">Leaving one of these?</h2>
    <div class="tbl-wrap">
      <table>
        <thead><tr><th scope="col">If you use</th><th scope="col">Switch to</th><th scope="col">Why</th><th scope="col">Also good</th></tr></thead>
        <tbody>{quick.map(({ b, alts }) => {
          const a = alts[0];
          return (
            <tr>
              <td><a href={`/alternatives/${b.id}`}>{b.name}</a></td>
              <td><a href={`/browsers/${a.result.browser.id}`}><b>{a.result.browser.name}</b></a></td>
              <td>{a.better.slice(0, 2).join(", ") || a.keeps.slice(0, 2).join(", ") || "Closest match overall"}</td>
              <td>{alts.slice(1, 3).map((x) => x.result.browser.name).join(", ")}</td>
            </tr>
          );
        })}</tbody>
      </table>
    </div>

    <QuizCta title="Want a pick for you, not for everyone?" text="The quiz ranks every browser against your OS, extensions, priorities, must-haves and dealbreakers in about two minutes." />

    <h2 id="leaving">Alternatives to a specific browser</h2>
    <p class="prose">Pick the browser you want to leave. Each page ranks replacements that keep what it does well and fix what it doesn't.</p>
    <ul class="linkgrid">{list.map(({ b, top }) => <li><a href={`/alternatives/${b.id}`}>{b.logo && <img src={b.logo} alt="" width="24" height="24" loading="lazy" />}<span>{b.name} alternatives<small>{top}</small></span></a></li>)}</ul>
    <h2>How we pick alternatives</h2>
    <p class="prose">Each list starts from the browser you want to leave. We keep what it's good at – if it scores 4/5 or more on privacy, polish, customisation, lightness or minimalism, its replacements have to match that – and weight up whatever it's weakest at, because that's usually why you're leaving. On top of that, alternatives get credit for keeping its signature features (vertical tabs, workspaces, split view, a built-in VPN or ad blocker) and its extension store, and lose points if they don't run on the same operating systems or if they swap a free browser for a paid one.</p>
    <p class="prose">AI-first browsers like ChatGPT Atlas, Comet and Dia are compared with other browsers that have a capable AI assistant or agent. Discontinued, beta-only and experimental browsers never appear as alternatives.</p>
    <h2>Switching without losing anything</h2>
    <ol class="prose">
      <li>Install the new browser from its official site and let it import bookmarks, passwords and history from your old one.</li>
      <li>Reinstall your extensions. Moving between Chromium browsers they come from the same Chrome Web Store; moving to a Firefox-based browser you'll find most of them on Firefox Add-ons. See <a href="/guides/browser-extensions">which browsers run which extensions</a>.</li>
      <li>Set it as your default browser, then keep the old one installed for a week in case a site you need misbehaves.</li>
    </ol>
    <h2>FAQ</h2>
    <div class="faq">{faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </div>
</Base>
