// Cloudflare Workers static-assets deployment for the static Astro build.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "browserwall",
  "compatibility_date": "2026-11-17",
  // Only browserwall.org serves the site: no *.workers.dev URL or preview URLs (avoids duplicate copies for search engines).
  "workers_dev": false,
  "preview_urls": false,
  // Tiny Worker for Markdown content negotiation ("Accept: text/markdown" -> the page's .md copy).
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
    // quiz.html is served at /quiz; /quiz.html and /quiz/ redirect there (matches our canonical URLs).
    "html_handling": "auto-trailing-slash",
    // Pages go through the Worker; static files are served directly.
    "run_worker_first": ["/*", "!/_astro/*", "!/logos/*", "!/*.png", "!/*.svg", "!/*.ico", "!/*.txt", "!/*.xml"]
  }
}
